namespace tests

  @SGNode("collectorCore")
  @suite
  class CollectorCoreTests extends rooibos.BaseTestSuite
    protected override function beforeEach()
      'bs:disable-next-line
      initializeAnalytics()
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("isCustomDataChanging")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns false when newCustomData is empty")
    function _()
      'bs:disable-next-line
      result = isCustomDataChanging({})

      m.assertFalse(result)
    end function

    @it("returns false when all values match the current sample")
    function _()
      'bs:disable-next-line
      updateSample({ customData1: "existingValue" })

      'bs:disable-next-line
      result = isCustomDataChanging({ customData1: "existingValue" })

      m.assertFalse(result)
    end function

    @it("returns true when a value differs from the current sample")
    function _()
      'bs:disable-next-line
      updateSample({ customData1: "oldValue" })

      'bs:disable-next-line
      result = isCustomDataChanging({ customData1: "newValue" })

      m.assertTrue(result)
    end function

    @it("returns true when a key does not exist on the current sample")
    function _()
      'bs:disable-next-line
      result = isCustomDataChanging({ customData1: "newValue" })

      m.assertTrue(result)
    end function

    @it("returns false when both new and existing values are invalid")
    function _()
      'bs:disable-next-line
      updateSample({ customData1: invalid })

      'bs:disable-next-line
      result = isCustomDataChanging({ customData1: invalid })

      m.assertFalse(result)
    end function

    @it("returns true when new value is invalid but existing value is a string")
    function _()
      'bs:disable-next-line
      updateSample({ customData1: "existingValue" })

      'bs:disable-next-line
      result = isCustomDataChanging({ customData1: invalid })

      m.assertTrue(result)
    end function

    @it("returns true when new value is a string but existing value is invalid")
    function _()
      'bs:disable-next-line
      updateSample({ customData1: invalid })

      'bs:disable-next-line
      result = isCustomDataChanging({ customData1: "newValue" })

      m.assertTrue(result)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("clearSampleValues")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("resets videoStartFailed, videoStartFailedReason and errorSeverity so they don't leak onto later samples")
    function _()
      'bs:disable-next-line
      updateSample({ videoStartFailed: true, videoStartFailedReason: "playerError", errorSeverity: "CRITICAL" })

      'bs:disable-next-line
      clearSampleValues()

      'bs:disable-next-line
      m.assertFalse(m.node.sample.videoStartFailed)
      'bs:disable-next-line
      m.assertInvalid(m.node.sample.videoStartFailedReason)
      'bs:disable-next-line
      m.assertInvalid(m.node.sample.errorSeverity)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("extractCustomDataFields")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns only customData fields from input")
    function _()
      input = { customData1: "a", customData2: "b", adImpressionId: "n/a", state: "playing" }

      'bs:disable-next-line
      result = extractCustomDataFields(input)

      m.assertEqual(result.customData1, "a")
      m.assertEqual(result.customData2, "b")
      m.assertFalse(result.DoesExist("adImpressionId"))
      m.assertFalse(result.DoesExist("state"))
    end function

    @it("returns empty AA when input contains no customData fields")
    function _()
      input = { adImpressionId: "n/a", videoTimeStart: 0 }

      'bs:disable-next-line
      result = extractCustomDataFields(input)

      m.assertEqual(result.Count(), 0)
    end function

    @it("returns empty AA when input is invalid")
    function _()
      'bs:disable-next-line
      result = extractCustomDataFields(invalid)

      m.assertEqual(result.Count(), 0)
    end function

    @it("preserves invalid customData field values")
    function _()
      input = { customData1: invalid, customData3: "value" }

      'bs:disable-next-line
      result = extractCustomDataFields(input)

      m.assertInvalid(result.customData1)
      m.assertEqual(result.customData3, "value")
      m.assertFalse(result.DoesExist("customData2"))
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("internalDestroy")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sends only the regular final event when no SSAI ad break is active")
    function _()
      mockTask = { finalEventData: invalid }
      'bs:disable-next-line
      m.node.AnalyticsDataTask = mockTask

      'bs:disable-next-line
      internalDestroy()

      m.assertEqual(mockTask.finalEventData.events.Count(), 1)
      m.assertEqual(mockTask.finalEventData.events[0].requestType, 0) ' REGULAR

      'bs:disable-next-line
      m.node.AnalyticsDataTask = m.top.findNode("analyticsDataTask")
    end function

    @it("prepends AD_ENGAGEMENT exit event when destroyed during an active SSAI ad break")
    function _()
      'bs:disable-next-line
      setupSsaiService()
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedPaidAds: 1 })
      'bs:disable-next-line
      adStart({ isSlate: false })

      mockTask = { finalEventData: invalid }
      'bs:disable-next-line
      m.node.AnalyticsDataTask = mockTask

      'bs:disable-next-line
      internalDestroy()

      m.assertEqual(mockTask.finalEventData.events.Count(), 2)
      m.assertEqual(mockTask.finalEventData.events[0].requestType, 1) ' AD_ENGAGEMENT
      m.assertEqual(mockTask.finalEventData.events[0].requestData.exitedAdBreak, true)
      m.assertEqual(mockTask.finalEventData.events[1].requestType, 0) ' REGULAR
      'bs:disable-next-line
      m.assertEqual(m.node.ssaiState, m.node.SSAI_STATES.IDLE)

      'bs:disable-next-line
      m.node.AnalyticsDataTask = m.top.findNode("analyticsDataTask")
    end function


    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("dropped frames tracking")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("reports the frames dropped since the previous sample")
    function _()
      videoNode = m.createMockVideoNode()
      'bs:disable-next-line
      startDroppedFramesTracking(videoNode)

      m.updateDecoderStats(videoNode, 2, 25)
      m.updateDecoderStats(videoNode, 5, 50)
      'bs:disable-next-line
      m.assertEqual(takeDroppedFrames(), 5)

      m.updateDecoderStats(videoNode, 9, 75)
      'bs:disable-next-line
      m.assertEqual(takeDroppedFrames(), 4)
      'bs:disable-next-line
      m.assertEqual(takeDroppedFrames(), 0)
    end function

    @it("keeps the drops from before a seek when the counters restart")
    function _()
      videoNode = m.createMockVideoNode()
      'bs:disable-next-line
      startDroppedFramesTracking(videoNode)

      m.updateDecoderStats(videoNode, 7, 460)
      ' seek: renderCount falls back to 0
      m.updateDecoderStats(videoNode, 0, 0)
      m.updateDecoderStats(videoNode, 3, 35)

      'bs:disable-next-line
      m.assertEqual(takeDroppedFrames(), 10)
    end function

    @it("detects a restart by renderCount even when the drop count is unchanged")
    function _()
      videoNode = m.createMockVideoNode()
      'bs:disable-next-line
      startDroppedFramesTracking(videoNode)

      m.updateDecoderStats(videoNode, 4, 485)
      'bs:disable-next-line
      takeDroppedFrames()
      ' new source: its own 4 drops, coincidentally the old count
      m.updateDecoderStats(videoNode, 4, 34)

      'bs:disable-next-line
      m.assertEqual(takeDroppedFrames(), 4)
    end function

    @it("does not count the previous source's stale counters again after a new source load")
    function _()
      videoNode = m.createMockVideoNode()
      'bs:disable-next-line
      startDroppedFramesTracking(videoNode)

      m.updateDecoderStats(videoNode, 6, 485)
      'bs:disable-next-line
      m.assertEqual(takeDroppedFrames(), 6)

      ' The old values stay on the node through the new source's startup sample
      'bs:disable-next-line
      m.assertEqual(takeDroppedFrames(), 0)

      m.updateDecoderStats(videoNode, 1, 34)
      'bs:disable-next-line
      m.assertEqual(takeDroppedFrames(), 1)
    end function

    @it("treats counters already running when tracking starts as the baseline")
    function _()
      videoNode = m.createMockVideoNode()
      videoNode.enableDecoderStats = true
      videoNode.decoderStats = { frameDropCount: 12, renderCount: 900 }

      'bs:disable-next-line
      startDroppedFramesTracking(videoNode)
      m.updateDecoderStats(videoNode, 14, 925)

      'bs:disable-next-line
      m.assertEqual(takeDroppedFrames(), 2)
    end function

    @it("counts from zero again once the decoder stats were gone")
    function _()
      videoNode = m.createMockVideoNode()
      'bs:disable-next-line
      startDroppedFramesTracking(videoNode)

      m.updateDecoderStats(videoNode, 3, 300)
      'bs:disable-next-line
      onDecoderStatsChanged({ getData: function()
          return invalid
      end function })
      m.updateDecoderStats(videoNode, 3, 400)

      'bs:disable-next-line
      m.assertEqual(takeDroppedFrames(), 6)
    end function

    @it("ignores decoder stats without numeric counters")
    function _()
      videoNode = m.createMockVideoNode()
      'bs:disable-next-line
      startDroppedFramesTracking(videoNode)

      videoNode.decoderStats = { frameDropCount: "3", renderCount: 25 }
      'bs:disable-next-line
      onDecoderStatsChanged({ node: videoNode, getData: function()
          return m.node.decoderStats
      end function })

      'bs:disable-next-line
      m.assertEqual(takeDroppedFrames(), 0)
    end function

    @it("reports 0 when there is no video node or it has no decoder stats")
    function _()
      'bs:disable-next-line
      startDroppedFramesTracking(invalid)
      'bs:disable-next-line
      m.assertEqual(takeDroppedFrames(), 0)

      'bs:disable-next-line
      startDroppedFramesTracking({ hasField: function(field)
          return false
      end function })
      'bs:disable-next-line
      m.assertEqual(takeDroppedFrames(), 0)
    end function

    @it("turns decoder stats off again on stop only if it turned them on")
    function _()
      ownNode = m.createMockVideoNode()
      'bs:disable-next-line
      startDroppedFramesTracking(ownNode)
      'bs:disable-next-line
      stopDroppedFramesTracking()
      m.assertFalse(ownNode.enableDecoderStats)
      m.assertInvalid(ownNode.observedField)

      appNode = m.createMockVideoNode()
      appNode.enableDecoderStats = true
      'bs:disable-next-line
      startDroppedFramesTracking(appNode)
      'bs:disable-next-line
      stopDroppedFramesTracking()
      m.assertTrue(appNode.enableDecoderStats)
    end function

    @it("stops tracking the previous video node when tracking starts again")
    function _()
      firstNode = m.createMockVideoNode()
      'bs:disable-next-line
      startDroppedFramesTracking(firstNode)
      m.updateDecoderStats(firstNode, 4, 100)

      secondNode = m.createMockVideoNode()
      'bs:disable-next-line
      startDroppedFramesTracking(secondNode)

      m.assertFalse(firstNode.enableDecoderStats)
      m.assertInvalid(firstNode.observedField)
      'bs:disable-next-line
      m.assertEqual(takeDroppedFrames(), 0)
    end function

    @it("stamps the dropped frames on the regular sample and clears them afterwards")
    function _()
      mockTask = CreateObject("roSGNode", "Node")
      mockTask.addFields({ eventData: {}, sendData: false })
      'bs:disable-next-line
      m.node.AnalyticsDataTask = mockTask

      videoNode = m.createMockVideoNode()
      'bs:disable-next-line
      startDroppedFramesTracking(videoNode)
      m.updateDecoderStats(videoNode, 3, 50)

      'bs:disable-next-line
      sendAnalyticsRequestAndClearValues()

      m.assertEqual(mockTask.eventData.requestData.droppedFrames, 3)
      'bs:disable-next-line
      m.assertEqual(m.node.sample.droppedFrames, 0)

      'bs:disable-next-line
      m.node.AnalyticsDataTask = m.top.findNode("analyticsDataTask")
    end function

    @it("stamps the dropped frames on the final sample and stops tracking on destroy")
    function _()
      mockTask = { finalEventData: invalid }
      'bs:disable-next-line
      m.node.AnalyticsDataTask = mockTask

      videoNode = m.createMockVideoNode()
      'bs:disable-next-line
      startDroppedFramesTracking(videoNode)
      m.updateDecoderStats(videoNode, 8, 50)

      'bs:disable-next-line
      internalDestroy()

      m.assertEqual(mockTask.finalEventData.events[0].requestData.droppedFrames, 8)
      m.assertFalse(videoNode.enableDecoderStats)

      'bs:disable-next-line
      m.node.AnalyticsDataTask = m.top.findNode("analyticsDataTask")
    end function

    function createMockVideoNode()
      return {
        enableDecoderStats: false,
        decoderStats: invalid,
        observedField: invalid,
        hasField: function(field)
          return field = "enableDecoderStats" or field = "decoderStats"
        end function,
        observeFieldScoped: function(field, callback)
          m.observedField = field
        end function,
        unobserveFieldScoped: function(field)
          if m.observedField = field then m.observedField = invalid
        end function
      }
    end function

    ' Sets the counters and delivers them like the firmware`s field change notification.
    sub updateDecoderStats(videoNode, frameDropCount, renderCount)
      videoNode.decoderStats = { frameDropCount: frameDropCount, renderCount: renderCount, repeatCount: 0, streamErrorCount: 0 }
      'bs:disable-next-line
      onDecoderStatsChanged({ node: videoNode, getData: function()
          return m.node.decoderStats
      end function })
    end sub
  end class

end namespace
