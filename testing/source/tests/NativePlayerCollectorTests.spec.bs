namespace tests

  @SGNode("nativePlayerCollector")
  @suite
  class NativePlayerCollectorTests extends rooibos.BaseTestSuite

    @describe("Test for the Native Player Collector")

    protected override function beforeEach()
      'bs:disable-next-line
      initializeAnalytics()

      m.mockPlayer = {
        position: 1447
        height: 1080
        width: 1920
        duration: 85
        unobserveFieldScoped: function(fieldName as string)
          print "unobserveFieldScoped stub: tried to unobserve field '";fieldName;"' on Native mockPlayer"
        end function
        observeFieldScoped: function(fieldName as string, funcName as string)
          print "observeFieldScoped stub: tried to observe field '";fieldName;"' on Native mockPlayer"
        end function
      }

      m.node.player = m.mockPlayer
    end function

    protected override function afterEach()
      m.cleanStubs()
      m.cleanMocks()
    end function

    @it("setAnalyticsConfig with valid params - returns true")
    @Params({ "customDataTest": "customData" })
    function _(analyticsConfig)
      'bs:disable-next-line
      isAnalyticsConfigSet = setAnalyticsConfig(analyticsConfig)
      m.AssertTrue(isAnalyticsConfigSet)
    end function


    @it("setAnalyticsConfig with invalid params - returns invalid")
    @Params(invalid)
    function _(analyticsConfig)
      'bs:disable-next-line
      isAnalyticsConfigSet = setAnalyticsConfig(analyticsConfig)
      m.AssertInvalid(isAnalyticsConfigSet)
    end function

    @it("should expose the error data to the user")
    function _()
      expectedErrorCode = 1447
      expectedErrorMessage = "Test error message"

      m.mockPlayer.errorCode = expectedErrorCode
      m.mockPlayer.errorMsg = expectedErrorMessage

      originalCollectorCore = m.node.collectorCore

      m.stubCall(m.node.collectorCore.callFunc, invalid)
      m.stubCall(m.node.collectorCore.unobserveFieldScoped, invalid)

      'bs:disable-next-line
      onError()
      errorEventData = m.node.top.error

      m.AssertNotInvalid(errorEventData)
      m.AssertEqual(errorEventData.error.code, expectedErrorCode)
      m.AssertEqual(errorEventData.error.message, expectedErrorMessage)

      m.node.collectorCore = originalCollectorCore
    end function

    @it("should apply user modifications when sending an error sample")
    function _()
      originalPlayerMockErrorCode = 1000
      originalPlayerMockErrorMessage = "ORIGINAL_PLAYER_ERROR"

      m.mockPlayer.errorCode = originalPlayerMockErrorCode
      m.mockPlayer.errorMsg = originalPlayerMockErrorMessage
      m.node.top.observeFieldScoped("error", "modifyNativeErrorData")

      'bs:disable-next-line
      onError()
      errorEventData = m.node.top.error

      m.assertEqual(errorEventData.error.code, 1001)
      m.assertEqual(errorEventData.error.message, "ORIGINAL_PLAYER_ERROR-MODIFIED")
      m.assertEqual(errorEventData.error.severity, "INFO")

      m.node.top.unobserveFieldScoped("error")
    end function

    @it("uses 'CRITICAL' as default level when submitting player errors (native)")
    function _()
      originalPlayerMockErrorCode = 1000
      originalPlayerMockErrorMessage = "ORIGINAL_PLAYER_ERROR"

      m.mockPlayer.errorCode = originalPlayerMockErrorCode
      m.mockPlayer.errorMsg = originalPlayerMockErrorMessage

      'bs:disable-next-line
      onError()
      errorEventData = m.node.top.error

      m.assertEqual(errorEventData.error.severity, "CRITICAL")
    end function

    @it("emits sample with state 'buffering' when buffering ends")
    function _()
      testContext = { capturedSampleData: invalid }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSampleData = sampleData
          end if
          return true
        end function,
        testContext: testContext
      }

      m.mockPlayer.availableAudioTracks = []
      m.mockPlayer.availableSubtitleTracks = []
      m.node.player = m.mockPlayer

      'bs:disable-next-line
      m.node.bufferTimer = CreateObject("roTimespan")

      'bs:disable-next-line
      onBufferingEnd()

      m.assertNotInvalid(testContext.capturedSampleData)
      m.assertEqual(testContext.capturedSampleData.state, "buffering")
      m.assertNotInvalid(testContext.capturedSampleData.buffered)

      m.node.collectorCore = originalCollectorCore
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("onStopped")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("closes out any active SSAI ad break so it isn't left open indefinitely")
    function _()
      testContext = { adBreakEndCalled: false }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "adBreakEnd"
            m.testContext.adBreakEndCalled = true
          end if
          return true
        end function,
        testContext: testContext
      }

      'bs:disable-next-line
      m.node.alreadySeeking = true
      'bs:disable-next-line
      m.node.seekStartPosition = 1000
      'bs:disable-next-line
      m.node.seekTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.bufferTimer = CreateObject("roTimespan")

      'bs:disable-next-line
      onStopped()

      m.assertTrue(testContext.adBreakEndCalled)
      'bs:disable-next-line
      m.assertFalse(m.node.alreadySeeking)
      'bs:disable-next-line
      m.assertInvalid(m.node.seekStartPosition)
      'bs:disable-next-line
      m.assertInvalid(m.node.seekTimer)
      'bs:disable-next-line
      m.assertInvalid(m.node.bufferTimer)

      m.node.collectorCore = originalCollectorCore
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("handleCurrentState")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("calls onStopped (closing any active SSAI ad break) when currentState is 'stopped'")
    function _()
      testContext = { adBreakEndCalled: false }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "adBreakEnd"
            m.testContext.adBreakEndCalled = true
          end if
          return true
        end function,
        testContext: testContext
      }

      'bs:disable-next-line
      m.node.playerStates = getPlayerStates()
      'bs:disable-next-line
      m.node.currentState = "stopped"

      'bs:disable-next-line
      handleCurrentState()

      m.assertTrue(testContext.adBreakEndCalled)

      m.node.collectorCore = originalCollectorCore
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("onSourceChanged")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("closes out any active SSAI ad break and returns early when content is invalid, without crashing")
    function _()
      testContext = { adBreakEndCalled: false }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "adBreakEnd"
            m.testContext.adBreakEndCalled = true
          end if
          return true
        end function,
        observeFieldScoped: function(fieldName as string, funcName as string)
        end function,
        unobserveFieldScoped: function(fieldName as string)
        end function,
        testContext: testContext
      }

      m.mockPlayer.content = invalid
      m.mockPlayer.state = "playing"
      m.node.player = m.mockPlayer

      'bs:disable-next-line
      m.node.currentState = "playing"

      'bs:disable-next-line
      onSourceChanged()

      m.assertTrue(testContext.adBreakEndCalled)

      m.node.collectorCore = originalCollectorCore
    end function

    @it("treats an initial source change (currentState = 'none') as a normal load, not a stop")
    function _()
      testContext = { adBreakEndCalled: false }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "adBreakEnd"
            m.testContext.adBreakEndCalled = true
          end if
          return true
        end function,
        observeFieldScoped: function(fieldName as string, funcName as string)
        end function,
        unobserveFieldScoped: function(fieldName as string)
        end function,
        testContext: testContext
      }

      m.mockPlayer.content = { getChildCount: function() as integer
          return 0
        end function }
      m.mockPlayer.state = "none"
      m.node.player = m.mockPlayer

      'bs:disable-next-line
      m.node.playerStates = getPlayerStates()
      'bs:disable-next-line
      m.node.currentState = "none"

      'bs:disable-next-line
      onSourceChanged()

      m.assertFalse(testContext.adBreakEndCalled)

      m.node.collectorCore = originalCollectorCore
    end function

    @it("treats a manual source change (currentState <> 'none', content present) as before, not a stop")
    function _()
      testContext = { adBreakEndCalled: false, setupSampleCalled: false }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "adBreakEnd"
            m.testContext.adBreakEndCalled = true
          else if funcName = "setupSample"
            m.testContext.setupSampleCalled = true
          end if
          return true
        end function,
        observeFieldScoped: function(fieldName as string, funcName as string)
        end function,
        unobserveFieldScoped: function(fieldName as string)
        end function,
        testContext: testContext
      }

      m.mockPlayer.content = { getChildCount: function() as integer
          return 0
        end function }
      m.mockPlayer.state = "playing"
      m.mockPlayer.availableAudioTracks = []
      m.mockPlayer.availableSubtitleTracks = []
      m.node.player = m.mockPlayer

      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.playerStates = getPlayerStates()
      'bs:disable-next-line
      m.node.currentState = "playing"
      'bs:disable-next-line
      m.node.previousState = "playing"

      'bs:disable-next-line
      onSourceChanged()

      m.assertFalse(testContext.adBreakEndCalled)
      m.assertTrue(testContext.setupSampleCalled)
      'bs:disable-next-line
      m.assertTrue(m.node.manualSourceChangeInProgress)

      m.node.collectorCore = originalCollectorCore
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("setCustomDataOnce")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("does nothing when customData is invalid")
    function _()
      testContext = { tempSampleCalled: false }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "createTempMetadataSampleAndSendAnalyticsRequest"
            m.testContext.tempSampleCalled = true
          end if
          return true
        end function,
        testContext: testContext
      }

      'bs:disable-next-line
      setCustomDataOnce(invalid)

      m.assertFalse(testContext.tempSampleCalled)
      m.node.collectorCore = originalCollectorCore
    end function

    @it("sends a customdatachange sample with duration=0, videoTimeStart=videoTimeEnd=currentTime, and the custom data fields")
    function _()
      testContext = { capturedTempSample: invalid, sendAnalyticsCalled: false }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "extractCustomDataFields"
            return sampleData
          else if funcName = "sendAnalyticsRequestAndClearValues"
            m.testContext.sendAnalyticsCalled = true
          else if funcName = "createTempMetadataSampleAndSendAnalyticsRequest"
            m.testContext.capturedTempSample = sampleData
          end if
          return true
        end function,
        testContext: testContext
      }

      m.mockPlayer.position = 10
      m.mockPlayer.availableAudioTracks = []
      m.mockPlayer.availableSubtitleTracks = []
      m.node.player = m.mockPlayer

      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.currentState = "playing"

      'bs:disable-next-line
      setCustomDataOnce({ customData3: "onceValue" })

      m.assertNotInvalid(testContext.capturedTempSample)
      m.assertEqual(testContext.capturedTempSample.customData3, "onceValue")
      m.assertEqual(testContext.capturedTempSample.state, "customdatachange")
      m.assertEqual(testContext.capturedTempSample.duration, 0)
      m.assertEqual(testContext.capturedTempSample.videoTimeStart, 10000)
      m.assertEqual(testContext.capturedTempSample.videoTimeEnd, 10000)
      m.assertFalse(testContext.sendAnalyticsCalled)
      m.node.collectorCore = originalCollectorCore
    end function

    @it("does not close the running sample regardless of player state")
    function _()
      testContext = { sendAnalyticsCalled: false, capturedTempSample: invalid }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "extractCustomDataFields"
            return sampleData
          else if funcName = "sendAnalyticsRequestAndClearValues"
            m.testContext.sendAnalyticsCalled = true
          else if funcName = "createTempMetadataSampleAndSendAnalyticsRequest"
            m.testContext.capturedTempSample = sampleData
          end if
          return true
        end function,
        testContext: testContext
      }

      m.mockPlayer.availableAudioTracks = []
      m.mockPlayer.availableSubtitleTracks = []
      m.node.player = m.mockPlayer

      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")

      for each state in ["setup", "playing", "paused"]
        testContext.sendAnalyticsCalled = false
        testContext.capturedTempSample = invalid
        'bs:disable-next-line
        m.node.currentState = state

        'bs:disable-next-line
        setCustomDataOnce({ customData3: "onceValue" })

        m.assertFalse(testContext.sendAnalyticsCalled)
        m.assertNotInvalid(testContext.capturedTempSample)
      end for

      m.node.collectorCore = originalCollectorCore
    end function

  end class

end namespace

function modifyNativeErrorData(errorEvent)
  errorData = errorEvent.getData()

  errorData.error.message = errorData.error.message + "-MODIFIED"
  errorData.error.code = errorData.error.code + 1
  errorData.error.severity = "INFO"

  m.top.error = errorData
end function