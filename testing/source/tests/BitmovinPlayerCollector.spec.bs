      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getCurrentTime" then return 10
        if functionName = "getAudio" then return invalid
        if functionName = "getSubtitle" then return invalid
        if functionName = "getDuration" then return 60
        return invalid
      end function

      'bs:disable-next-line
      m.node.currentState = "paused"
      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")

      'bs:disable-next-line
      destroy()

