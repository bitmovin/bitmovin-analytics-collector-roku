      m.assertEqual(testContext.capturedSampleData.played, 19500)
      m.assertTrue(testContext.internalDestroyCalled)

      m.node.collectorCore = originalCollectorCore
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("onSourceUnloaded")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("closes out any active SSAI ad break so it isn't left open indefinitely")
    function _()
      testContext = { adBreakEndCalled: false }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "adBreakEnd"
            m.testContext.adBreakEndCalled = true
          end if
          return true
        end function,
        testContext: testContext
      }

      'bs:disable-next-line
      m.node.currentState = "setup"
      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")

      'bs:disable-next-line
      onSourceUnloaded()

      m.assertTrue(testContext.adBreakEndCalled)
      'bs:disable-next-line
      m.assertEqual(m.node.videoStartUpTime, -1)

      m.node.collectorCore = originalCollectorCore
    end function

    @it("snapshots everything a later error sample needs to describe this session (AN-5074)")
    function _()
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, arg = invalid)
          if funcName = "getCurrentImpressionId" then return "impression-123"
          if funcName = "getCurrentSequenceNumber" then return 4
          return true
        end function
      }

      m.mockPlayer.playerState = "error"

      'bs:disable-next-line
      m.node.currentState = "setup"
      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.didAttemptPlay = true
      'bs:disable-next-line
      m.node.didVideoPlay = false

      'bs:disable-next-line
      onSourceUnloaded()

      'bs:disable-next-line
      session = m.node.pendingErrorSession
      m.assertNotInvalid(session)
      m.assertEqual(session.impressionId, "impression-123")
      m.assertEqual(session.sequenceNumber, 4)
      m.assertEqual(session.state, "error")
      m.assertTrue(session.didAttemptPlay)
      m.assertFalse(session.didVideoPlay)
      m.assertTrue(session.duration >= 0)

      'bs:disable-next-line
      m.node.didVideoPlay = true
      'bs:disable-next-line
      onSourceUnloaded()
      'bs:disable-next-line
      m.assertTrue(m.node.didVideoPlay)

      m.node.collectorCore = originalCollectorCore
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("onSourceLoaded")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("re-arms observers and clears the torn-down flag when observers were previously torn down")
    function _()
      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getConfig" then return { source: {} }
        return invalid
      end function
      m.mockPlayer.BitmovinPlayerState = { SETUP: "setup" }

      observeContext = { calls: [] }
      m.mockPlayer.observeContext = observeContext
      m.mockPlayer.observeFieldScoped = function(fieldName as string, funcName as string)
        m.observeContext.calls.Push(fieldName)
      end function

      'bs:disable-next-line
      m.node.currentState = "setup"
      'bs:disable-next-line
      m.node.observersTornDown = true

      'bs:disable-next-line
      onSourceLoaded()

      'bs:disable-next-line
      m.assertFalse(m.node.observersTornDown)
      m.assertTrue(observeContext.calls.Count() > 0)
    end function

    @it("clears didVideoPlay so the newly loaded source starts its own startup")
    function _()
      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getConfig" then return { source: {} }
        return invalid
      end function
      m.mockPlayer.BitmovinPlayerState = { SETUP: "setup" }

      'bs:disable-next-line
      m.node.currentState = "setup"
      'bs:disable-next-line
      m.node.observersTornDown = false
      'bs:disable-next-line
      m.node.didVideoPlay = true

      'bs:disable-next-line
      onSourceLoaded()

      'bs:disable-next-line
      m.assertFalse(m.node.didVideoPlay)
    end function

    @it("does not re-arm observers when they were never torn down (would discard a still-pending error notification)")
    function _()
      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getConfig" then return { source: {} }
        return invalid
      end function
      m.mockPlayer.BitmovinPlayerState = { SETUP: "setup" }
      ' Deliberately no observeFieldScoped stub on the mock player - if
      ' setUpObservers() were called despite the flag being false, this
      ' would throw and fail the test.

      'bs:disable-next-line
      m.node.currentState = "setup"
      'bs:disable-next-line
      m.node.observersTornDown = false

      'bs:disable-next-line
      onSourceLoaded()

      'bs:disable-next-line
      m.assertFalse(m.node.observersTornDown)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("onError - session attribution when an error outlives its session (AN-5074)")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("attributes the error sample to the failed session and restores the current session afterward when a newer source has already loaded")
    function _()
      testContext = { updateSampleCalls: [] }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, arg = invalid)
          if funcName = "updateSample"
            m.testContext.updateSampleCalls.Push(arg)
          else if funcName = "getCurrentImpressionId"
            return "new-session-impression-id"
          else if funcName = "getCurrentSequenceNumber"
            return 3
          end if
          return true
        end function,
        testContext: testContext
      }

      m.mockPlayer.error = { code: 1000, message: "network error" }
      ' The app already failed over, so the collector switched session before
      ' this error notification was delivered - the impression no longer
      ' matches the one snapshotted on the unload.
      m.mockPlayer.playerState = "ready"
      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getAudio" then return invalid
        if functionName = "getSubtitle" then return invalid
        if functionName = "getDuration" then return invalid
        if functionName = "getCurrentTime" then return 0
        return invalid
      end function

      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.didAttemptPlay = true
      'bs:disable-next-line
      m.node.didVideoPlay = false
      'bs:disable-next-line
      m.node.observersTornDown = false
      'bs:disable-next-line
      m.node.pendingErrorSession = { impressionId: "failed-session-impression-id", sequenceNumber: 5, duration: 100, state: "error", didAttemptPlay: true, didVideoPlay: false }

      'bs:disable-next-line
      onError()

      ' 3 updateSample calls total: swap to the failed session, the actual
      ' error sample content (from sendAnalyticsRequestAndClearValues itself),
      ' then swap back to the current session.
      m.assertEqual(testContext.updateSampleCalls.Count(), 3)
      m.assertEqual(testContext.updateSampleCalls[0].impressionId, "failed-session-impression-id")
      m.assertEqual(testContext.updateSampleCalls[0].sequenceNumber, 5)
      m.assertEqual(testContext.updateSampleCalls[2].impressionId, "new-session-impression-id")
      m.assertEqual(testContext.updateSampleCalls[2].sequenceNumber, 3)
      'bs:disable-next-line
      m.assertFalse(m.node.observersTornDown)
      'bs:disable-next-line
      m.assertInvalid(m.node.pendingErrorSession)

      m.node.collectorCore = originalCollectorCore
    end function

    @it("tears down observers and never touches session identifiers when the error belongs to the current session")
    function _()
      testContext = { updateSampleCalls: [] }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, arg = invalid)
          if funcName = "updateSample"
            m.testContext.updateSampleCalls.Push(arg)
          else if funcName = "getCurrentImpressionId"
            return "same-session-id"
          else if funcName = "getCurrentSequenceNumber"
            return 2
          end if
          return true
        end function,
        unobserveFieldScoped: function(fieldName as string)
        end function,
        testContext: testContext
      }

      m.mockPlayer.error = { code: 1000, message: "network error" }
      ' Still in the error state - no failover source was loaded, so this is the
      ' normal terminal-failure case and the error belongs to the current session.
      m.mockPlayer.playerState = "error"
      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getAudio" then return invalid
        if functionName = "getSubtitle" then return invalid
        if functionName = "getDuration" then return invalid
        if functionName = "getCurrentTime" then return 0
        return invalid
      end function

      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.didAttemptPlay = false
      'bs:disable-next-line
      m.node.didVideoPlay = false
      'bs:disable-next-line
      m.node.observersTornDown = false
      'bs:disable-next-line
      m.node.pendingErrorSession = { impressionId: "same-session-id", sequenceNumber: 2 }

      'bs:disable-next-line
      onError()

      ' Exactly 1 updateSample call: the actual error sample content (from
      ' sendAnalyticsRequestAndClearValues itself) - no session-swap calls,
      ' since the error belongs to the current session.
      m.assertEqual(testContext.updateSampleCalls.Count(), 1)
      m.assertEqual(testContext.updateSampleCalls[0].errorCode, 1000)
      m.assertInvalid(testContext.updateSampleCalls[0].impressionId)
      'bs:disable-next-line
      m.assertTrue(m.node.observersTornDown)
      'bs:disable-next-line
      m.assertInvalid(m.node.pendingErrorSession)

      m.node.collectorCore = originalCollectorCore
    end function

    @it("reports a mid-playback error as an error, not a video start failure")
    function _()
      testContext = { updateSampleCalls: [] }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, arg = invalid)
          if funcName = "updateSample"
            m.testContext.updateSampleCalls.Push(arg)
          else if funcName = "getCurrentImpressionId"
            return "same-session-id"
          else if funcName = "getCurrentSequenceNumber"
            return 2
          end if
          return true
        end function,
        unobserveFieldScoped: function(fieldName as string)
        end function,
        testContext: testContext
      }

      m.mockPlayer.error = { code: 1000, message: "network error" }
      m.mockPlayer.playerState = "error"
      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getConfig" then return { source: {} }
        if functionName = "getCurrentTime" then return 0
        return invalid
      end function
      m.mockPlayer.BitmovinPlayerState = { SETUP: "setup" }

      'bs:disable-next-line
      m.node.currentState = "playing"
      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.didAttemptPlay = true
      'bs:disable-next-line
      m.node.didVideoPlay = true
      'bs:disable-next-line
      m.node.observersTornDown = false

      'bs:disable-next-line
      onSourceUnloaded()
      'bs:disable-next-line
      onError()

      errorSample = testContext.updateSampleCalls[testContext.updateSampleCalls.Count() - 1]
      m.assertEqual(errorSample.errorCode, 1000)
      m.assertInvalid(errorSample.videoStartFailedReason)
      m.assertNotEqual(errorSample.videoStartFailed, true)

      m.node.collectorCore = originalCollectorCore
    end function

    @it("still attributes the error to the failed session while the player reports the error state (AN-5074)")
    function _()
      testContext = { updateSampleCalls: [] }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, arg = invalid)
          if funcName = "updateSample"
            m.testContext.updateSampleCalls.Push(arg)
          else if funcName = "getCurrentImpressionId"
            return "new-session-impression-id"
          else if funcName = "getCurrentSequenceNumber"
            return 0
          end if
          return true
        end function,
        unobserveFieldScoped: function(fieldName as string)
        end function,
        testContext: testContext
      }

      m.mockPlayer.error = { code: 1000, message: "network error" }
      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getAudio" then return invalid
        if functionName = "getSubtitle" then return invalid
        if functionName = "getDuration" then return invalid
        if functionName = "getCurrentTime" then return 0
        return invalid
      end function

      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.didAttemptPlay = false
      'bs:disable-next-line
      m.node.didVideoPlay = false
      'bs:disable-next-line
      m.node.observersTornDown = false
      ' Device-observed ordering: the player emits "sourceLoaded" - which is
      ' what switches the session - before it moves playerState off "error",
      ' and the pending error notification lands in between. So an error from
      ' the previous session is handled while the player still reports
      ' "error", and the session identity is the only signal that has moved.
      m.mockPlayer.playerState = "error"
      'bs:disable-next-line
      m.node.pendingErrorSession = {
        impressionId: "failed-session-impression-id"
        sequenceNumber: 9
        duration: 100
        state: "error"
        didAttemptPlay: false
        didVideoPlay: false
      }

      'bs:disable-next-line
      onError()

      ' 3 updateSample calls: swap to the failed session, the error sample
      ' content itself, then the swap back to the current session.
      m.assertEqual(testContext.updateSampleCalls.Count(), 3)
      m.assertEqual(testContext.updateSampleCalls[0].impressionId, "failed-session-impression-id")
      m.assertEqual(testContext.updateSampleCalls[0].sequenceNumber, 9)
      m.assertEqual(testContext.updateSampleCalls[2].impressionId, "new-session-impression-id")
      'bs:disable-next-line
      m.assertFalse(m.node.observersTornDown)
      'bs:disable-next-line
      m.assertInvalid(m.node.pendingErrorSession)

      m.node.collectorCore = originalCollectorCore
    end function

    @it("describes the failed session, not the failover source that is running by now (AN-5074)")
    function _()
      testContext = { updateSampleCalls: [] }
      originalCollectorCore = m.node.collectorCore
      originalWatchdog = m.node.videoStartTimeoutTimer

      m.node.collectorCore = {
        callFunc: function(funcName as string, arg = invalid)
          if funcName = "updateSample"
            m.testContext.updateSampleCalls.Push(arg)
          else if funcName = "getCurrentImpressionId"
            return "failover-session-impression-id"
          else if funcName = "getCurrentSequenceNumber"
            return 0
          end if
          return true
        end function,
        testContext: testContext
      }

      m.mockPlayer.error = { code: 1000, message: "network error" }
      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getCurrentTime" then return 0
        return invalid
      end function

      ' The failover source is already playing by the time the previous
      ' session's error notification is delivered: it flipped didVideoPlay,
      ' marked the state timer again and moved playerState on.
      m.mockPlayer.playerState = "playing"
      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.didAttemptPlay = true
      'bs:disable-next-line
      m.node.didVideoPlay = true
      'bs:disable-next-line
      m.node.observersTornDown = false

      ' The startup watchdog is only started for the first source that attempts
      ' playback, so it belongs to the failover source now - this error must
      ' not stop it.
      watchdog = { control: "start", unobserveFieldScoped: function(fieldName as string)
      end function }
      'bs:disable-next-line
      m.node.videoStartTimeoutTimer = watchdog

      'bs:disable-next-line
      m.node.pendingErrorSession = {
        impressionId: "failed-session-impression-id"
        sequenceNumber: 7
        duration: 4321
        state: "error"
        didAttemptPlay: true
        didVideoPlay: false
      }

      'bs:disable-next-line
      onError()

      ' The middle call is the error sample itself: it has to carry the failed
      ' session's startup failure, its duration and its state - none of which
      ' are true of the live player any more.
      m.assertEqual(testContext.updateSampleCalls.Count(), 3)
      errorSample = testContext.updateSampleCalls[1]
      m.assertTrue(errorSample.videoStartFailed)
      m.assertNotInvalid(errorSample.videoStartFailedReason)
      m.assertEqual(errorSample.duration, 4321)
      m.assertEqual(errorSample.state, "error")
      m.assertEqual(watchdog.control, "start")

      m.node.videoStartTimeoutTimer = originalWatchdog
      m.node.collectorCore = originalCollectorCore
    end function

    @it("stops the startup watchdog when the error belongs to the session that started it")
    function _()
      originalCollectorCore = m.node.collectorCore
      originalWatchdog = m.node.videoStartTimeoutTimer

      m.node.collectorCore = {
        callFunc: function(funcName as string, arg = invalid)
          if funcName = "getCurrentImpressionId" then return "same-session-id"
          return true
        end function,
        unobserveFieldScoped: function(fieldName as string)
        end function
      }

      m.mockPlayer.error = { code: 1000, message: "network error" }
      m.mockPlayer.playerState = "error"
      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getCurrentTime" then return 0
        return invalid
      end function

      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.didAttemptPlay = true
      'bs:disable-next-line
      m.node.didVideoPlay = false
      'bs:disable-next-line
      m.node.observersTornDown = false

      watchdog = { control: "start", unobserveFieldScoped: function(fieldName as string)
      end function }
      'bs:disable-next-line
      m.node.videoStartTimeoutTimer = watchdog

      ' Same impression as the snapshot - this session's own error.
      'bs:disable-next-line
      m.node.pendingErrorSession = {
        impressionId: "same-session-id"
        sequenceNumber: 2
        duration: 100
        state: "error"
        didAttemptPlay: true
        didVideoPlay: false
      }

      'bs:disable-next-line
      onError()

      m.assertEqual(watchdog.control, "stop")

      m.node.videoStartTimeoutTimer = originalWatchdog
      m.node.collectorCore = originalCollectorCore
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("onVideoDownloadQualityChanged / processQualityChangeEvent")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("only updates sample when not in playing state (initial quality)")
    function _()
      testContext = { capturedSamples: [], sendRequestCalled: false }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSamples.Push(sampleData)
          else if funcName = "sendAnalyticsRequestAndClearValues"
            m.testContext.sendRequestCalled = true
          end if
          return true
        end function,
        testContext: testContext
      }

      m.mockPlayer.videoDownloadQualityChanged = { targetQuality: { bitrate: 5000000 } }
      'bs:disable-next-line
      m.node.currentState = "setup"

      'bs:disable-next-line
      onVideoDownloadQualityChanged()

      m.assertEqual(testContext.capturedSamples.Count(), 1)
      m.assertEqual(testContext.capturedSamples[0].videoBitrate, 5000000)
      m.assertFalse(testContext.sendRequestCalled)
      'bs:disable-next-line
      m.assertEqual(m.node.currentVideoBitrate, 5000000)

      m.node.collectorCore = originalCollectorCore
    end function

    @it("sends qualityChange sample when player is playing")
    function _()
      testContext = { capturedSamples: [], sendRequestCount: 0 }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSamples.Push(sampleData)
          else if funcName = "sendAnalyticsRequestAndClearValues"
            m.testContext.sendRequestCount++
          end if
          return true
        end function,
        testContext: testContext
      }

      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getCurrentTime" then return 30
        if functionName = "getAudio" then return invalid
        if functionName = "getSubtitle" then return invalid
        if functionName = "getDuration" then return 60
        return invalid
      end function

      m.mockPlayer.videoDownloadQualityChanged = { targetQuality: { bitrate: 5000000 } }
      'bs:disable-next-line
      m.node.currentState = "playing"
      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.currentVideoBitrate = 2000000

      'bs:disable-next-line
      onVideoDownloadQualityChanged()

      ' Should send 2 analytics requests: one for played duration, one for qualityChange
      m.assertEqual(testContext.sendRequestCount, 2)
      'bs:disable-next-line
      m.assertEqual(m.node.currentVideoBitrate, 5000000)

      m.node.collectorCore = originalCollectorCore
    end function

    @it("sends played sample before qualityChange sample when playing")
    function _()
      testContext = { capturedSamples: [] }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSamples.Push(sampleData)
          end if
          return true
        end function,
        testContext: testContext
      }

      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getCurrentTime" then return 30
        if functionName = "getAudio" then return invalid
        if functionName = "getSubtitle" then return invalid
        if functionName = "getDuration" then return 60
        return invalid
      end function

      m.mockPlayer.videoDownloadQualityChanged = { targetQuality: { bitrate: 5000000 } }
      'bs:disable-next-line
      m.node.currentState = "playing"
      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.currentVideoBitrate = 2000000

      'bs:disable-next-line
      onVideoDownloadQualityChanged()

      m.assertTrue(testContext.capturedSamples.Count() >= 2)
      m.assertEqual(testContext.capturedSamples[0].state, "playing")
      m.assertNotInvalid(testContext.capturedSamples[0].played)
      m.assertEqual(testContext.capturedSamples[1].state, "qualityChange")
      m.assertEqual(testContext.capturedSamples[1].videoBitrate, 5000000)

      m.node.collectorCore = originalCollectorCore
    end function

    @it("does not send qualityChange sample when paused")
    function _()
      testContext = { capturedSamples: [], sendRequestCount: 0 }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSamples.Push(sampleData)
          else if funcName = "sendAnalyticsRequestAndClearValues"
            m.testContext.sendRequestCount++
          end if
          return true
        end function,
        testContext: testContext
      }

      m.mockPlayer.videoDownloadQualityChanged = { targetQuality: { bitrate: 5000000 } }
      'bs:disable-next-line
      m.node.currentState = "paused"

      'bs:disable-next-line
      onVideoDownloadQualityChanged()

      m.assertEqual(testContext.sendRequestCount, 0)
      m.assertEqual(testContext.capturedSamples.Count(), 1)
      m.assertEqual(testContext.capturedSamples[0].videoBitrate, 5000000)

      m.node.collectorCore = originalCollectorCore
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("programChange")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("does nothing when called with invalid metadata")
    function _()
      testContext = stubCollectorCore(m.node)

      'bs:disable-next-line
      programChange(invalid)

      m.assertEqual(testContext.callCount, 0)
    end function

    ' Between initializeAnalytics and initializePlayer, m.playerStates is invalid. The state is
    ' deliberately not "setup", to show the guard is the missing vocabulary and not the state.
    @it("degrades to a metadata update when called before initializePlayer")
    function _()
      testContext = stubCollectorCore(m.node)
      givePlayingSession(m.node, "playing")
      'bs:disable-next-line
      m.node.playerStates = invalid

      'bs:disable-next-line
      programChange({ title: "New Program" })

      m.assertEqual(testContext.capturedMetadata.title, "New Program")
      m.assertFalse(testContext.calledFunctions.doesExist("setupSample"))
    end function

    @it("degrades to a metadata update when no state has been recorded yet")
    function _()
      testContext = stubCollectorCore(m.node)
      givePlayingSession(m.node, invalid)

      'bs:disable-next-line
      programChange({ title: "New Program" })

      m.assertTrue(testContext.calledFunctions.doesExist("updateAnalyticsConfig"))
      m.assertFalse(testContext.calledFunctions.doesExist("setupSample"))
    end function

    @it("concludes current impression and starts new one when playing")
    function _()
      testContext = stubCollectorCore(m.node)
      givePlayingSession(m.node, "playing")

      'bs:disable-next-line
      programChange({ title: "New Program", videoId: "prog-2" })

      m.assertTrue(testContext.capturedSamples.Count() >= 3)
      finalSample = testContext.capturedSamples[0]
      m.assertTrue(finalSample.isProgramChange)
      m.assertNotInvalid(finalSample.played)
      m.assertEqual(finalSample.state, "playing")

      m.assertNotInvalid(testContext.capturedMetadata)
      m.assertEqual(testContext.capturedMetadata.title, "New Program")

      programChangeSample = testContext.capturedSamples[testContext.capturedSamples.Count() - 1]
      m.assertTrue(programChangeSample.isProgramChange)
      m.assertEqual(programChangeSample.videoStartupTime, 1)
      m.assertEqual(programChangeSample.state, "programchange")
      m.assertEqual(programChangeSample.duration, 1)
    end function

    @it("concludes current impression when paused")
    function _()
      testContext = stubCollectorCore(m.node)
      givePlayingSession(m.node, "paused")

      'bs:disable-next-line
      programChange({ title: "New Program" })

      finalSample = testContext.capturedSamples[0]
      m.assertTrue(finalSample.isProgramChange)
      m.assertNotInvalid(finalSample.paused)
      m.assertEqual(finalSample.state, "paused")
    end function

    ' STALLING is one of the states THEO has no equivalent for. It must still conclude the
    ' impression - it just attributes no played/paused time to the closing sample.
    @it("sends final sample without duration fields when stalling")
    function _()
      testContext = stubCollectorCore(m.node)
      givePlayingSession(m.node, "stalling")

      'bs:disable-next-line
      programChange({ title: "New Program" })

      finalSample = testContext.capturedSamples[0]
      m.assertTrue(finalSample.isProgramChange)
      m.assertInvalid(finalSample.played)
      m.assertInvalid(finalSample.paused)
      m.assertEqual(finalSample.state, "stalling")
      m.assertTrue(testContext.calledFunctions.doesExist("setupSample"))
    end function

    ' Once startup has finished, every player state opens a new impression - READY included. The
    ' sentinel is "has playback ever started", not a particular state name.
    @it("starts a new impression when in READY state after startup finished")
    function _()
      testContext = stubCollectorCore(m.node)
      givePlayingSession(m.node, "ready")

      'bs:disable-next-line
      programChange({ title: "New Program" })

      m.assertTrue(testContext.calledFunctions.doesExist("setupSample"))
    end function

    ' The player passes through SETUP, READY and STALLING before the first frame. A programChange
    ' there is a normal startup with different metadata, not a boundary. Unlike THEO, no single
    ' state is the sentinel - the guard is whether playback ever started. Matches
    ' `!isStartupFinished` on Android.
    @it("degrades to a metadata update while playback is still starting up")
    function _()
      for each startupState in ["setup", "ready", "stalling"]
        testContext = stubCollectorCore(m.node)
        giveStartingUpSession(m.node, startupState)

        'bs:disable-next-line
        programChange({ title: "New Program" })

        m.assertEqual(testContext.capturedMetadata.title, "New Program")
        m.assertFalse(testContext.calledFunctions.doesExist("setupSample"), "state " + startupState + " should not open a new impression")
        m.assertFalse(testContext.calledFunctions.doesExist("sendAnalyticsRequestAndClearValues"), "state " + startupState + " should not send a sample")
      end for
    end function

    ' The startup path applies the config fields and the stream URL, same as a real boundary -
    ' getMetadataFromAnalyticsConfig whitelists config fields, so the URLs need updateSample.
    @it("applies the new program's stream URL while playback is still starting up")
    function _()
      testContext = stubCollectorCore(m.node)
      giveStartingUpSession(m.node, "ready")

      'bs:disable-next-line
      programChange({ title: "New Program", m3u8Url: "http://example.com/news.m3u8" })

      m.assertEqual(testContext.capturedMetadata.title, "New Program")
      m.assertEqual(testContext.capturedSamples.Count(), 1)
      m.assertEqual(testContext.capturedSamples[0].m3u8Url, "http://example.com/news.m3u8")
      m.assertEqual(testContext.capturedSamples[0].streamFormat, "hls")
      m.assertFalse(testContext.calledFunctions.doesExist("setupSample"))
    end function

    ' The guard has to survive a source change, not just the first startup: onSourceUnloaded
    ' clears didVideoPlay, so the next source's startup window degrades the same way.
    @it("degrades to a metadata update during the startup of a source loaded after the first")
    function _()
      testContext = stubCollectorCore(m.node)
      givePlayingSession(m.node, "playing")

      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getConfig" then return { source: {} }
        return invalid
      end function
      m.mockPlayer.BitmovinPlayerState = { SETUP: "setup" }

      ' The second source loading is what clears didVideoPlay - deliberately not set by hand here,
      ' or the test would pass with the production reset removed.
      'bs:disable-next-line
      onSourceLoaded()

      'bs:disable-next-line
      m.node.currentState = "stalling"
      testContext.calledFunctions = {}

      'bs:disable-next-line
      programChange({ title: "New Program" })

      m.assertEqual(testContext.capturedMetadata.title, "New Program")
      m.assertFalse(testContext.calledFunctions.doesExist("setupSample"))
    end function

    ' The SDK fires PLAYING→READY on source teardown; handlePreviousState suppresses that sample
    ' and parks the duration for destroy(). A programChange in that window must settle it against
    ' the outgoing impression, or destroy() later bills it to the new one.
    @it("settles the parked pre-READY duration against the outgoing impression")
    function _()
      testContext = stubCollectorCore(m.node)
      givePlayingSession(m.node, "ready")
      parkPreReadyDuration(m.node, "playing", 5000)

      'bs:disable-next-line
      programChange({ title: "New Program" })

      settledSample = testContext.capturedSamples[0]
      m.assertEqual(settledSample.played, 5000)
      m.assertEqual(settledSample.state, "playing")
      m.assertInvalid(settledSample.isProgramChange)

      m.assertTrue(testContext.capturedSamples[1].isProgramChange)

      'bs:disable-next-line
      m.assertInvalid(m.node.priorStateBeforeReady)
      'bs:disable-next-line
      m.assertInvalid(m.node.priorDurationBeforeReady)
    end function

    @it("does not settle the parked duration on the metadata-only startup path")
    function _()
      testContext = stubCollectorCore(m.node)
      giveStartingUpSession(m.node, "ready")
      parkPreReadyDuration(m.node, "playing", 5000)

      'bs:disable-next-line
      programChange({ title: "New Program" })

      m.assertFalse(testContext.calledFunctions.doesExist("sendAnalyticsRequestAndClearValues"))
      'bs:disable-next-line
      m.assertEqual(m.node.priorStateBeforeReady, "playing")
      'bs:disable-next-line
      m.assertEqual(m.node.priorDurationBeforeReady, 5000)
    end function

    @it("sends no settling sample when nothing is parked")
    function _()
      testContext = stubCollectorCore(m.node)
      givePlayingSession(m.node, "playing")

      'bs:disable-next-line
      programChange({ title: "New Program" })

      m.assertTrue(testContext.capturedSamples[0].isProgramChange)
    end function

    @it("passes skipHeartbeatReset true for both programChange sends")
    function _()
      testContext = stubCollectorCore(m.node)
      givePlayingSession(m.node, "playing")

      'bs:disable-next-line
      programChange({ title: "New Program" })

      m.assertEqual(testContext.capturedSkipHeartbeatReset.Count(), 2)
      m.assertTrue(testContext.capturedSkipHeartbeatReset[0])
      m.assertTrue(testContext.capturedSkipHeartbeatReset[1])
    end function

    ' Ordinary sends must keep the heartbeat reset they have always had - the 4th parameter is
    ' additive, not a behaviour change for existing call sites.
    @it("leaves skipHeartbeatReset false for ordinary sends")
    function _()
      testContext = stubCollectorCore(m.node)
      givePlayingSession(m.node, "playing")

      'bs:disable-next-line
      sendAnalyticsRequestAndClearValues({ played: 100 }, 100, "playing")

      m.assertEqual(testContext.capturedSkipHeartbeatReset.Count(), 1)
      m.assertFalse(testContext.capturedSkipHeartbeatReset[0])
    end function

    @it("sends final sample before setupSample")
    function _()
      testContext = stubCollectorCore(m.node)
      givePlayingSession(m.node, "playing")

      'bs:disable-next-line
      programChange({ title: "New Program" })

      firstUpdateSampleIndex = -1
      setupSampleIndex = -1
      for i = 0 to testContext.callOrder.Count() - 1
        if testContext.callOrder[i] = "updateSample" and firstUpdateSampleIndex = -1 then firstUpdateSampleIndex = i
        if testContext.callOrder[i] = "setupSample" then setupSampleIndex = i
      end for

      m.assertTrue(firstUpdateSampleIndex >= 0, "updateSample should have been called")
      m.assertTrue(setupSampleIndex >= 0, "setupSample should have been called")
      m.assertTrue(firstUpdateSampleIndex < setupSampleIndex, "final sample should be sent before setupSample")
    end function

    ' The timer must restart at the boundary: the READY-recovery machinery in
    ' onPlayerStateChanged/destroy reads m.playerStateTimer and a stale mark would misattribute.
    @it("attributes pre-boundary time to the closing sample and re-marks the state timer")
    function _()
      testContext = stubCollectorCore(m.node)
      givePlayingSession(m.node, "playing")
      sleep(60)

      'bs:disable-next-line
      programChange({ title: "New Program" })

      finalSample = testContext.capturedSamples[0]
      m.assertTrue(finalSample.played >= 50, "closing sample should carry the time spent before the boundary")
      m.assertTrue(finalSample.duration >= 50, "closing sample duration should match the state duration")

      'bs:disable-next-line
      m.assertTrue(m.node.playerStateTimer.TotalMilliseconds() < 50, "state timer should have been re-marked at the boundary")
    end function

    ' The URL fields are applied through updateSample rather than updateAnalyticsConfig, because
    ' getMetadataFromAnalyticsConfig whitelists config fields and would drop them.
    @it("applies the new program's stream URL to the sample")
    function _()
      testContext = stubCollectorCore(m.node)
      givePlayingSession(m.node, "playing")

      'bs:disable-next-line
      programChange({ title: "New Program", mpdUrl: "http://example.com/new.mpd" })

      foundStreamFormat = invalid
      foundMpdUrl = invalid
      for each sample in testContext.capturedSamples
        if sample.streamFormat <> invalid then foundStreamFormat = sample.streamFormat
        if sample.mpdUrl <> invalid then foundMpdUrl = sample.mpdUrl
      end for

      m.assertEqual(foundStreamFormat, "dash")
      m.assertEqual(foundMpdUrl, "http://example.com/new.mpd")
    end function

    ' Guards the seam: if the base-level call sites resolved to the baseCollector stubs, the API
    ' would silently no-op. Only the Bitmovin implementation adds the video window fields.
    @it("resolves the collector's own send primitives, not the baseCollector stubs")
    function _()
      testContext = stubCollectorCore(m.node)
      givePlayingSession(m.node, "playing")

      'bs:disable-next-line
      programChange({ title: "New Program" })

      m.assertTrue(testContext.capturedSamples.Count() >= 3, "base stubs would have swallowed every send")
      finalSample = testContext.capturedSamples[0]
      m.assertEqual(finalSample.videoWindowHeight, 1080)
      m.assertEqual(finalSample.videoWindowWidth, 1920)
      m.assertNotInvalid(finalSample.time)
    end function

  end class
end namespace


'+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
' Utility functions
'+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

function modifyErrorData(errorEvent)
  errorData = errorEvent.getData()

  ' Event data looks like this:
  ' {
  '   error: {
  '     message: ...
  '     code: ...
  '     severity: "CRITICAL" ' (by default, can be changed to "INFO")
  '   },
  '   errorContext: {
  '     originalError: { ...original error reported by player }
  '   }
  ' }

  errorData.error.message = errorData.error.message + "-MODIFIED"
  errorData.error.code = errorData.error.code + 1
  errorData.error.severity = "INFO"

  m.top.error = errorData
end function

'Swap a recording stub in for the collectorCore child node, and return what it records.
'@param {Object} node - The collector's `m`.
'@return {Object} - callCount, callOrder, calledFunctions, capturedSamples, capturedMetadata and
'                   capturedSkipHeartbeatReset, filled in as the collector calls collectorCore.
function stubCollectorCore(node)
  stub = {
    testContext: {
      callCount: 0
      callOrder: []
      calledFunctions: {}
      capturedSamples: []
      capturedMetadata: invalid
      capturedSkipHeartbeatReset: []
    }
    observeFieldScoped: function(fieldName as string, funcName as string)
    end function
    unobserveFieldScoped: function(fieldName as string)
    end function
    callFunc: function(funcName as string, arg = invalid)
      m.testContext.callCount++
      m.testContext.callOrder.Push(funcName)
      m.testContext.calledFunctions[funcName] = true

      if funcName = "updateSample" then m.testContext.capturedSamples.Push(arg)
      if funcName = "updateAnalyticsConfig" then m.testContext.capturedMetadata = arg
      if funcName = "sendAnalyticsRequestAndClearValues" then m.testContext.capturedSkipHeartbeatReset.Push(arg)

      return true
    end function
  }

  node.collectorCore = stub
  return stub.testContext
end function

'Put the collector in the state it holds mid-playback, ready for a program boundary.
sub givePlayingSession(node, state = "playing")
  node.currentState = state
  node.playerStateTimer = CreateObject("roTimespan")
  node.didVideoPlay = true
  node.priorStateBeforeReady = invalid
  node.priorDurationBeforeReady = invalid
end sub

'Same, but before playback has ever started - the window programChange must not treat as a boundary.
sub giveStartingUpSession(node, state)
  givePlayingSession(node, state)
  node.didVideoPlay = false
end sub

'Park a duration the way a PLAYING/PAUSED→READY transition does, for destroy() to recover.
sub parkPreReadyDuration(node, state, duration)
  node.priorStateBeforeReady = state
  node.priorDurationBeforeReady = duration
end sub

'+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
' Mock Data
'+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

function getMockedAppInfoWithPlayerKeyData(manifestData)
  mockAppInfo = {}
  'mimic behaviour of roAppInfo's getValue() function
  mockAppInfo.mockManifestData = manifestData
  mockAppInfo.getValue = function(key)
    if m.mockManifestData[key] <> invalid
      value = m.mockManifestData[key]
    else
      value = ""
    end if

    return value
  end function

  return mockAppInfo
end function
