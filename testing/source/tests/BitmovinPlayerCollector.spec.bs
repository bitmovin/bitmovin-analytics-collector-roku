namespace tests

  @SGNode("bitmovinPlayerCollector")
  @suite
  class BitmovinPlayerCollectorTests extends rooibos.BaseTestSuite

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("BitmovinPlayerCollector")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    protected override function beforeEach()
      ' NOTE: Cannot mock license calls right now because the components in this project are not
      ' based on Brighterscript classes. Citation from the official Rooibos docs:
      ' "You cannot stub node methods. If there is no . reference to a method (via an
      ' associated array style object), then Rooibos cannot mock it."
      ' https://github.com/rokucommunity/rooibos/blob/master/docs/index.md#nuances-of-testing-nodes

      'bs:disable-next-line
      initializeAnalytics()

      m.mockPlayer = {
        currentTime: 1447
        FindNode: function(nodeName as string)
          print "FindNode stub: tried to find node '";nodeName; "' on mockPlayer"

          if nodeName = "MainVideo" then return {
            height: 1080
            width: 1920
          }

          print "No mock for node in place - returning invalid"
          return invalid
        end function
        callFunc: function(functionName as string, arg = invalid)
          print "callFunc stub: tried to invoke function '"; functionName; "' with arg '";arg;"' on mockPlayer"
          return invalid
        end function
        unobserveFieldScoped: function(fieldName as string)
          print "unobserveFieldScoped stub: tried to unobserve field '";fieldName;"' on Bitmovin mockPlayer"
        end function
      }

      m.node.player = m.mockPlayer
      'bs:disable-next-line
      m.node.playerStates = {
        PLAYING: "playing"
        PAUSED: "paused"
        READY: "ready"
        STALLING: "stalling"
        FINISHED: "finished"
        SETUP: "setup"
      }
    end function

    protected override function afterEach()
      m.cleanStubs()
      m.cleanMocks()
    end function

    @it("should extract the player key from the channel manifest with valid parameters")
    function _()
      manifestData = { "bitmovin_player_license_key": "dummyKeyValue" }
      appInfo = getMockedAppInfoWithPlayerKeyData(manifestData)
      expectedPlayerKey = manifestData.bitmovin_player_license_key

      'bs:disable-next-line
      extractedPlayerKey = getPlayerKeyFromManifest(appInfo)

      m.AssertEqual(extractedPlayerKey, expectedPlayerKey)
    end function

    @it("should extract the player key from the channel manifest with invalid parameters")
    function _()
      appInfo = invalid

      'bs:disable-next-line
      bitmovinPlayerKey = getPlayerKeyFromManifest(appInfo)

      m.AssertInvalid(bitmovinPlayerKey)
    end function

    @it("should be able to set the analytics config with valid parameters")
    function _()
      analyticsConfig = { "customDataTest": "customData" }

      'bs:disable-next-line
      isAnalyticsConfigSet = setAnalyticsConfig(analyticsConfig)

      m.AssertTrue(isAnalyticsConfigSet)
    end function

    @it("should return invalid when setting the analytics config to 'invalid'")
    function _()
      analyticsConfig = invalid

      'bs:disable-next-line
      isAnalyticsConfigSet = setAnalyticsConfig(analyticsConfig)

      m.AssertInvalid(isAnalyticsConfigSet)
    end function

    @it("should expose the error data to the user")
    function _()
      expectedErrorCode = 1447
      expectedErrorMessage = "Test error message"

      m.mockPlayer.error = {
        code: expectedErrorCode,
        message: expectedErrorMessage
      }

      originalCollectorCore = m.node.collectorCore

      m.stubCall(m.node.collectorCore.callFunc, invalid)
      m.stubCall(m.node.collectorCore.unobserveFieldScoped, invalid)

      'bs:disable-next-line
      onError()
      errorEventData = m.node.top.error

      m.AssertNotInvalid(errorEventData)
      m.AssertEqual(errorEventData.error.code, expectedErrorCode)
      m.AssertEqual(errorEventData.error.message, expectedErrorMessage)

      ' NOTE: cleanStubs does not seem to properly restore stubbed objects/methods, so we are doing it manually here
      m.node.collectorCore = originalCollectorCore
    end function

    @it("should apply user modifications when sending an error sample")
    function _()
      originalPlayerMockError = {
        code: 1000
        message: "ORIGINAL_PLAYER_ERROR"
      }

      m.mockPlayer.error = originalPlayerMockError
      m.node.top.observeFieldScoped("error", "modifyErrorData")

      'bs:disable-next-line
      onError()
      errorEventData = m.node.top.error

      m.assertEqual(errorEventData.error.code, 1001)
      m.assertEqual(errorEventData.error.message, "ORIGINAL_PLAYER_ERROR-MODIFIED")
      m.assertEqual(errorEventData.error.severity, "INFO")

      m.node.top.unobserveFieldScoped("error")
    end function

    @it("uses 'CRITICAL' as default level when submitting player errors")
    function _()
      originalPlayerMockError = {
        code: 1000
        message: "ORIGINAL_PLAYER_ERROR"
      }

      m.mockPlayer.error = originalPlayerMockError

      'bs:disable-next-line
      onError()
      errorEventData = m.node.top.error

      m.assertEqual(errorEventData.error.severity, "CRITICAL")
    end function

    @it("closes out any active SSAI ad break on error, since Roku errors are always terminal")
    function _()
      testContext = { adBreakEndCalled: false }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "adBreakEnd"
            m.testContext.adBreakEndCalled = true
          end if
          return true
        end function,
        unobserveFieldScoped: function(fieldName as string)
        end function,
        testContext: testContext
      }

      m.mockPlayer.error = {
        code: 1000
        message: "some error"
      }

      'bs:disable-next-line
      onError()

      m.assertTrue(testContext.adBreakEndCalled)

      m.node.collectorCore = originalCollectorCore
    end function

    @it("should gracefully handle 'player.getCurrentTime' returning 'invalid'")
    function _()
      m.mockPlayer.callFunc = function(functionName)
        return invalid
      end function

      'bs:disable-next-line
      currentPlayerTime = getCurrentPlayerTimeInMs()

      m.assertEqual(currentPlayerTime, 0)
    end function

    @it("should return the actual player time in milliseconds if valid")
    function _()
      m.mockPlayer.callFunc = function(functionName)
        return 1.447
      end function

      'bs:disable-next-line
      currentPlayerTime = getCurrentPlayerTimeInMs()

      m.assertEqual(currentPlayerTime, 1447)
    end function

    @it("emits sample with state 'buffering' when stalling ends (normalizes player-specific state name)")
    function _()
      testContext = { capturedSampleData: invalid }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSampleData = sampleData
          end if
          return true
        end function,
        testContext: testContext
      }

      'bs:disable-next-line
      m.node.bufferTimer = CreateObject("roTimespan")

      'bs:disable-next-line
      onBufferingEnd()

      m.assertNotInvalid(testContext.capturedSampleData)
      m.assertEqual(testContext.capturedSampleData.state, "buffering")
      m.assertNotInvalid(testContext.capturedSampleData.buffered)

      m.node.collectorCore = originalCollectorCore
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("setCustomDataOnce")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("does nothing when customData is invalid")
    function _()
      testContext = { tempSampleCalled: false }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "createTempMetadataSampleAndSendAnalyticsRequest"
            m.testContext.tempSampleCalled = true
          end if
          return true
        end function,
        testContext: testContext
      }

      'bs:disable-next-line
      setCustomDataOnce(invalid)

      m.assertFalse(testContext.tempSampleCalled)
      m.node.collectorCore = originalCollectorCore
    end function

    @it("sends a customdatachange sample with duration=0, videoTimeStart=videoTimeEnd=currentTime, and the custom data fields")
    function _()
      testContext = { capturedTempSample: invalid, sendAnalyticsCalled: false }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "extractCustomDataFields"
            return sampleData
          else if funcName = "sendAnalyticsRequestAndClearValues"
            m.testContext.sendAnalyticsCalled = true
          else if funcName = "createTempMetadataSampleAndSendAnalyticsRequest"
            m.testContext.capturedTempSample = sampleData
          end if
          return true
        end function,
        testContext: testContext
      }

      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getCurrentTime" then return 10
        if functionName = "getAudio" then return invalid
        if functionName = "getSubtitle" then return invalid
        if functionName = "getDuration" then return 60
        return invalid
      end function

      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.currentState = "playing"

      'bs:disable-next-line
      setCustomDataOnce({ customData3: "onceValue" })

      m.assertNotInvalid(testContext.capturedTempSample)
      m.assertEqual(testContext.capturedTempSample.customData3, "onceValue")
      m.assertEqual(testContext.capturedTempSample.state, "customdatachange")
      m.assertEqual(testContext.capturedTempSample.duration, 0)
      m.assertEqual(testContext.capturedTempSample.videoTimeStart, 10000)
      m.assertEqual(testContext.capturedTempSample.videoTimeEnd, 10000)
      m.assertFalse(testContext.sendAnalyticsCalled)
      m.node.collectorCore = originalCollectorCore
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("stopVideoStartUpTimer")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sends correct autoplay value for each config shape")
    @params(invalid, false)
    @params({}, false)
    @params({ playback: {} }, false)
    @params({ playback: { autoplay: true } }, true)
    @params({ playback: { autoplay: false } }, false)
    function _(playerConfig, expectedAutoplay)
      testContext = { capturedSampleData: invalid }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSampleData = sampleData
          end if
          return true
        end function,
        testContext: testContext
      }

      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getConfig" then return m.playerConfig
        if functionName = "getAudio" then return invalid
        if functionName = "getSubtitle" then return invalid
        if functionName = "getDuration" then return invalid
        return invalid
      end function
      m.mockPlayer.playerConfig = playerConfig

      'bs:disable-next-line
      m.node.videoStartupTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.videoStartUpTime = -1

      'bs:disable-next-line
      stopVideoStartUpTimer()

      m.assertNotInvalid(testContext.capturedSampleData)
      m.assertEqual(testContext.capturedSampleData.autoplay, expectedAutoplay)

      m.node.collectorCore = originalCollectorCore
    end function

    @it("does not close the running sample regardless of player state")
    function _()
      testContext = { sendAnalyticsCalled: false, capturedTempSample: invalid }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "extractCustomDataFields"
            return sampleData
          else if funcName = "sendAnalyticsRequestAndClearValues"
            m.testContext.sendAnalyticsCalled = true
          else if funcName = "createTempMetadataSampleAndSendAnalyticsRequest"
            m.testContext.capturedTempSample = sampleData
          end if
          return true
        end function,
        testContext: testContext
      }

      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getCurrentTime" then return 10
        if functionName = "getAudio" then return invalid
        if functionName = "getSubtitle" then return invalid
        if functionName = "getDuration" then return 60
        return invalid
      end function

      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")

      for each state in ["setup", "playing", "paused"]
        testContext.sendAnalyticsCalled = false
        testContext.capturedTempSample = invalid
        'bs:disable-next-line
        m.node.currentState = state

        'bs:disable-next-line
        setCustomDataOnce({ customData3: "onceValue" })

        m.assertFalse(testContext.sendAnalyticsCalled)
        m.assertNotInvalid(testContext.capturedTempSample)
      end for

      m.node.collectorCore = originalCollectorCore
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("destroy")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sends final sample with played duration when state is playing")
    function _()
      testContext = { capturedSampleData: invalid, internalDestroyCalled: false }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSampleData = sampleData
          else if funcName = "internalDestroy"
            m.testContext.internalDestroyCalled = true
          end if
          return true
        end function,
        unobserveFieldScoped: function(field as string)
        end function,
        testContext: testContext
      }

      m.mockPlayer.callFunc = function(functionName as string, arg = invalid)
        if functionName = "getCurrentTime" then return 10
        if functionName = "getAudio" then return invalid
        if functionName = "getSubtitle" then return invalid
        if functionName = "getDuration" then return 60
        return invalid
      end function

      'bs:disable-next-line
      m.node.currentState = "playing"
      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")

      'bs:disable-next-line
      destroy()

      m.assertNotInvalid(testContext.capturedSampleData)
      m.assertEqual(testContext.capturedSampleData.state, "playing")
      m.assertNotInvalid(testContext.capturedSampleData.played)
      m.assertTrue(testContext.internalDestroyCalled)

      m.node.collectorCore = originalCollectorCore
    end function

    @it("sends final sample with paused duration when state is paused")
    function _()
      testContext = { capturedSampleData: invalid }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
