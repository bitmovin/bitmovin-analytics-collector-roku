namespace tests
  @SGNode("theoPlayerCollector")
  @suite
  class CollectorCoreUtilsTests extends rooibos.BaseTestSuite

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getVideoWindowSize")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("uses video node dimensions when height and width are set")
    function _()
      video = { height: 720, width: 1280 }

      'bs:disable-next-line
      result = getVideoWindowSize(video)

      m.assertEqual(result.videoWindowHeight, 720)
      m.assertEqual(result.videoWindowWidth, 1280)
    end function

    @it("falls back to display size when video height is 0")
    function _()
      video = { height: 0, width: 1280 }

      'bs:disable-next-line
      result = getVideoWindowSize(video)

      'bs:disable-next-line
      m.assertEqual(result.videoWindowHeight, m.node.deviceInfo.GetDisplaySize().h)
      m.assertEqual(result.videoWindowWidth, 1280)
    end function

    @it("falls back to display size when video width is 0")
    function _()
      video = { height: 720, width: 0 }

      'bs:disable-next-line
      result = getVideoWindowSize(video)

      m.assertEqual(result.videoWindowHeight, 720)
      'bs:disable-next-line
      m.assertEqual(result.videoWindowWidth, m.node.deviceInfo.GetDisplaySize().w)
    end function

    @it("falls back to display size when video height is invalid")
    function _()
      video = { height: invalid, width: 1280 }

      'bs:disable-next-line
      result = getVideoWindowSize(video)

      'bs:disable-next-line
      m.assertEqual(result.videoWindowHeight, m.node.deviceInfo.GetDisplaySize().h)
      m.assertEqual(result.videoWindowWidth, 1280)
    end function

    @it("falls back to display size when video width is invalid")
    function _()
      video = { height: 720, width: invalid }

      'bs:disable-next-line
      result = getVideoWindowSize(video)

      m.assertEqual(result.videoWindowHeight, 720)
      'bs:disable-next-line
      m.assertEqual(result.videoWindowWidth, m.node.deviceInfo.GetDisplaySize().w)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("extractCustomDataFields")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns only customData fields from input")
    function _()
      input = { customData1: "a", customData2: "b", adImpressionId: "n/a", state: "playing" }

      'bs:disable-next-line
      result = extractCustomDataFields(input)

      m.assertEqual(result.customData1, "a")
      m.assertEqual(result.customData2, "b")
      m.assertFalse(result.DoesExist("adImpressionId"))
      m.assertFalse(result.DoesExist("state"))
    end function

    @it("returns empty AA when input contains no customData fields")
    function _()
      input = { adImpressionId: "n/a", videoTimeStart: 0 }

      'bs:disable-next-line
      result = extractCustomDataFields(input)

      m.assertEqual(result.Count(), 0)
    end function

    @it("returns empty AA when input is invalid")
    function _()
      'bs:disable-next-line
      result = extractCustomDataFields(invalid)

      m.assertEqual(result.Count(), 0)
    end function

    @it("preserves invalid customData field values")
    function _()
      input = { customData1: invalid, customData3: "value" }

      'bs:disable-next-line
      result = extractCustomDataFields(input)

      m.assertInvalid(result.customData1)
      m.assertEqual(result.customData3, "value")
      m.assertFalse(result.DoesExist("customData2"))
    end function

  end class

end namespace
