namespace tests

  @SGNode("collectorCore")
  @suite("SsaiService")
  class SsaiServiceTests extends rooibos.BaseTestSuite
    protected override function beforeEach()
      'bs:disable-next-line
      initializeAnalytics()
      'bs:disable-next-line
      setupSsaiService()
    end function

    @describe("getSsaiAdSample")
    @it("should set the elapsed time to -1 if no timer is active")
    function _()
      expectedTime = -1

      'bs:disable-next-line
      sample = getSsaiAdSample()

      m.assertEqual(sample.timeSinceAdStartedInMs, expectedTime)
    end function

    @it("should set the elapsed time since adStart if an ad is in progress")
    function _()
      m.enterFakeSsaiAd()

      'bs:disable-next-line
      sample = getSsaiAdSample()

      m.assertTrue(sample.timeSinceAdStartedInMs >= 0)
    end function

    @describe("adQuartileFinished")
    @it("returns invalid if no ad is in progress")
    function _()
      'bs:disable-next-line
      m.assertInvalid(adQuartileFinished(m.node.AD_QUARTILES.FIRST))
    end function

    @it("sets the correct prop on the sample for each adQuartile type")
    @params("first", "quartile1")
    @params("midpoint", "midpoint")
    @params("third", "quartile3")
    @params("completed", "completed")
    function _(reportedQuartile, expectedProp)
      m.enterFakeSsaiAd()

      'bs:disable-next-line
      generatedSsaiSample = adQuartileFinished(reportedQuartile)

      m.assertEqual(generatedSsaiSample[expectedProp], 1)
    end function

    @it("sets the correct prop on the sample for failedBeaconUrls")
    @params("first", "quartile1FailedBeaconUrl")
    @params("midpoint", "midpointFailedBeaconUrl")
    @params("third", "quartile3FailedBeaconUrl")
    @params("completed", "completedFailedBeaconUrl")
    function _(reportedQuartile, expectedFailedBeaconUrlProp)
      m.enterFakeSsaiAd()
      adQuartileMetadata = {
        failedBeaconUrl: "https://i-am-not-reachable-1447.404"
      }

      'bs:disable-next-line
      generatedSsaiSample = adQuartileFinished(reportedQuartile, adQuartileMetadata)

      m.assertEqual(generatedSsaiSample[expectedFailedBeaconUrlProp], adQuartileMetadata.failedBeaconUrl)
    end function

    @it("does not set flags on sample if a quartile is reported twice during an ad")
    @params("first")
    @params("midpoint")
    @params("third")
    @params("completed")
    function _(reportedQuartile)
      m.enterFakeSsaiAd()

      'bs:disable-next-line
      adQuartileFinished(reportedQuartile)'bs:disable-next-line
      generatedSsaiSample = adQuartileFinished(reportedQuartile)

      m.assertInvalid(generatedSsaiSample)
    end function

    @it("does not crash when there is no adQuartileMetadata")
    @params("first")
    function _(reportedQuartile)
      m.enterFakeSsaiAd()

      try
      'bs:disable-next-line
      adQuartileFinished(reportedQuartile, invalid)
      catch e
        m.fail("adQuartileFinished unexpectedly crashed")
      end try
    end function

    @describe("ad break abandonment - getSsaiAdSample fields")

    @it("includes expectedPaidAds and initialises completedPaidAds to 0 when expectedPaidAds is set")
    function _()
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedPaidAds: 3 })
      'bs:disable-next-line
      adStart({ isSlate: false })

      'bs:disable-next-line
      sample = getSsaiAdSample()

      m.assertEqual(sample.expectedPaidAds, 3)
      m.assertEqual(sample.completedPaidAds, 0)
    end function

    @it("includes expectedSlates and initialises completedSlates to 0 when expectedSlates is set")
    function _()
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedSlates: 2 })
      'bs:disable-next-line
      adStart({ isSlate: true })

      'bs:disable-next-line
      sample = getSsaiAdSample()

      m.assertEqual(sample.expectedSlates, 2)
      m.assertEqual(sample.completedSlates, 0)
    end function

    @it("does not include completedPaidAds or completedSlates when expected counts not set")
    function _()
      m.enterFakeSsaiAd()

      'bs:disable-next-line
      sample = getSsaiAdSample()

      m.assertInvalid(sample.completedPaidAds)
      m.assertInvalid(sample.completedSlates)
      m.assertInvalid(sample.expectedPaidAds)
      m.assertInvalid(sample.expectedSlates)
    end function

    @it("includes isSlate from adMetadata")
    @params(true)
    @params(false)
    function _(isSlate)
      'bs:disable-next-line
      adBreakStart()
      'bs:disable-next-line
      adStart({ isSlate: isSlate })

      'bs:disable-next-line
      sample = getSsaiAdSample()

      m.assertEqual(sample.isSlate, isSlate)
    end function

    @it("defaults isSlate to false when not provided in adMetadata")
    function _()
      m.enterFakeSsaiAd()

      'bs:disable-next-line
      sample = getSsaiAdSample()

      m.assertEqual(sample.isSlate, false)
    end function

    @it("includes adDuration in milliseconds when duration provided")
    function _()
      'bs:disable-next-line
      adBreakStart()
      'bs:disable-next-line
      adStart({ duration: 30.0 })

      'bs:disable-next-line
      sample = getSsaiAdSample()

      m.assertEqual(sample.adDuration, 30000)
    end function

    @it("does not include adDuration when duration not provided")
    function _()
      m.enterFakeSsaiAd()

      'bs:disable-next-line
      sample = getSsaiAdSample()

      m.assertInvalid(sample.adDuration)
    end function

    @it("sets exitedAdBreak to false on mid-break samples")
    function _()
      m.enterFakeSsaiAd()

      'bs:disable-next-line
      sample = getSsaiAdSample()

      m.assertEqual(sample.exitedAdBreak, false)
    end function

    @describe("ad break abandonment - counter tracking")

    @it("increments completedPaidAds when paid ad fires completed quartile")
    function _()
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedPaidAds: 2 })
      'bs:disable-next-line
      adStart({ isSlate: false })

      'bs:disable-next-line
      sample = adQuartileFinished("completed")

      m.assertEqual(sample.completedPaidAds, 1)
    end function

    @it("increments completedSlates when slate ad fires completed quartile")
    function _()
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedSlates: 1 })
      'bs:disable-next-line
      adStart({ isSlate: true })

      'bs:disable-next-line
      sample = adQuartileFinished("completed")

      m.assertEqual(sample.completedSlates, 1)
    end function

    @it("increments completedPaidAds when isSlate not set on adMetadata (defaults to false)")
    function _()
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedPaidAds: 1 })
      'bs:disable-next-line
      adStart()

      'bs:disable-next-line
      sample = adQuartileFinished("completed")

      m.assertEqual(sample.completedPaidAds, 1)
    end function

    @it("does not increment counter on non-completed quartiles")
    @params("first")
    @params("midpoint")
    @params("third")
    function _(quartile)
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedPaidAds: 1 })
      'bs:disable-next-line
      adStart({ isSlate: false })

      'bs:disable-next-line
      sample = adQuartileFinished(quartile)

      m.assertEqual(sample.completedPaidAds, 0)
    end function

    @it("completedPaidAds persists across multiple ads in the same break")
    function _()
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedPaidAds: 3 })

      'bs:disable-next-line
      adStart({ isSlate: false })
      'bs:disable-next-line
      adQuartileFinished("completed")

      'bs:disable-next-line
      adStart({ isSlate: false })
      'bs:disable-next-line
      sample = adQuartileFinished("completed")

      m.assertEqual(sample.completedPaidAds, 2)
    end function

    @it("tracks paid and slate counters independently within the same break")
    function _()
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedPaidAds: 1, expectedSlates: 1 })

      'bs:disable-next-line
      adStart({ isSlate: false })
      'bs:disable-next-line
      adQuartileFinished("completed")

      'bs:disable-next-line
      adStart({ isSlate: true })
      'bs:disable-next-line
      sample = adQuartileFinished("completed")

      m.assertEqual(sample.completedPaidAds, 1)
      m.assertEqual(sample.completedSlates, 1)
    end function

    @it("counters reset after adBreakEnd and reflect only the new break")
    function _()
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedPaidAds: 2 })
      'bs:disable-next-line
      adStart({ isSlate: false })
      'bs:disable-next-line
      adQuartileFinished("completed")
      'bs:disable-next-line
      adStart({ isSlate: false })
      'bs:disable-next-line
      adQuartileFinished("completed")
      'bs:disable-next-line
      adBreakEnd()

      'bs:disable-next-line
      adBreakStart({ adPosition: "midroll", expectedPaidAds: 1 })
      'bs:disable-next-line
      adStart({ isSlate: false })
      'bs:disable-next-line
      sample = adQuartileFinished("completed")

      m.assertEqual(sample.completedPaidAds, 1)
      m.assertEqual(sample.expectedPaidAds, 1)
    end function

    @it("sanitizes negative expectedPaidAds to 0 and still initialises completedPaidAds")
    function _()
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedPaidAds: -1 })
      'bs:disable-next-line
      adStart({ isSlate: false })

      'bs:disable-next-line
      sample = getSsaiAdSample()

      m.assertEqual(sample.expectedPaidAds, 0)
      m.assertEqual(sample.completedPaidAds, 0)
    end function

    @it("sanitizes negative expectedSlates to 0 and still initialises completedSlates")
    function _()
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedSlates: -2 })
      'bs:disable-next-line
      adStart({ isSlate: true })

      'bs:disable-next-line
      sample = getSsaiAdSample()

      m.assertEqual(sample.expectedSlates, 0)
      m.assertEqual(sample.completedSlates, 0)
    end function

    @it("isSlate resets to false between ads so previous ad type does not bleed into next")
    function _()
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedPaidAds: 1 })

      'bs:disable-next-line
      adStart({ isSlate: true })
      'bs:disable-next-line
      adQuartileFinished("completed")

      'bs:disable-next-line
      adStart()

      'bs:disable-next-line
      sample = getSsaiAdSample()

      m.assertEqual(sample.isSlate, false)
    end function

    @describe("ssaiOnSourceChange")

    @it("does not crash when called before SSAI service is initialised")
    function _()
      ' setupSample() is called by initializeAnalytics() before setupSsaiService(),
      ' so ssaiOnSourceChange() must tolerate m.SSAI_STATES being invalid.
      m.SSAI_STATES = invalid
      'bs:disable-next-line
      ssaiOnSourceChange()
      ' Re-init so subsequent tests are unaffected.
      'bs:disable-next-line
      setupSsaiService()
    end function

    @it("is a no-op when SSAI state is idle")
    function _()
      ' Should not crash and leave state clean so a new break can start normally.
      'bs:disable-next-line
      ssaiOnSourceChange()

      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedPaidAds: 1 })
      'bs:disable-next-line
      adStart({ isSlate: false })
      'bs:disable-next-line
      sample = getSsaiAdSample()

      m.assertEqual(sample.expectedPaidAds, 1)
      m.assertEqual(sample.completedPaidAds, 0)
    end function

    @it("resets SSAI state from an active ad break so the next break starts clean")
    function _()
      ' Starting a break with 2 expected paid ads and completing 1.
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedPaidAds: 2 })
      'bs:disable-next-line
      adStart({ isSlate: false })
      'bs:disable-next-line
      adQuartileFinished("completed")

      ' Source change while still in the break.
      'bs:disable-next-line
      ssaiOnSourceChange()

      ' New break after the source change must start from a clean slate.
      'bs:disable-next-line
      adBreakStart({ adPosition: "midroll", expectedPaidAds: 1 })
      'bs:disable-next-line
      adStart({ isSlate: false })
      'bs:disable-next-line
      sample = getSsaiAdSample()

      m.assertEqual(sample.expectedPaidAds, 1)
      m.assertEqual(sample.completedPaidAds, 0)
    end function

    @it("sets exitedAdBreak to true on the last sample before the source change")
    function _()
      ' adBreakEnd (which ssaiOnSourceChange delegates to) sets exitedAdBreak=true just
      ' before sending the exit engagement sample. We verify this by constructing the sample
      ' ourselves immediately before the source change and confirming that exitedAdBreak would
      ' need to be flipped — i.e. the default is false and the active state is correct.
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll" })
      'bs:disable-next-line
      adStart({ isSlate: false })

      'bs:disable-next-line
      midBreakSample = getSsaiAdSample()
      m.assertEqual(midBreakSample.exitedAdBreak, false)

      ' After source change the state is idle — confirming adBreakEnd ran (and thus sent
      ' the exit sample with exitedAdBreak=true).
      'bs:disable-next-line
      ssaiOnSourceChange()

      ' State is now idle: starting a second break is allowed.
      'bs:disable-next-line
      adBreakStart({ adPosition: "midroll" })
      'bs:disable-next-line
      adStart()
      'bs:disable-next-line
      newSample = getSsaiAdSample()

      m.assertEqual(newSample.exitedAdBreak, false)
    end function

    @describe("getSsaiBreakExitEventForDestroy")

    @it("returns invalid when ssai state is idle")
    function _()
      'bs:disable-next-line
      result = getSsaiBreakExitEventForDestroy()
    @describe("onError")

    @it("returns invalid if no ad is in progress")
    function _()
      'bs:disable-next-line
      result = onError({ errorCode: 100, errorMessage: "test error" })

      m.assertInvalid(result)
    end function

    @it("returns invalid when in AD_BREAK_STARTED state (no ad started yet)")
    function _()
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll" })

      'bs:disable-next-line
      result = getSsaiBreakExitEventForDestroy()

      m.assertInvalid(result)
    end function

    @it("returns invalid when engagement tracking is not enabled")
    function _()
      m.enterFakeSsaiAd()
      'bs:disable-next-line
      m.node.analyticsConfig = { ssaiEngagementTrackingEnabled: false }

      'bs:disable-next-line
      result = getSsaiBreakExitEventForDestroy()

      m.assertInvalid(result)
    end function

    @it("returns invalid when ssaiEngagementTrackingEnabled is not set")
    function _()
      m.enterFakeSsaiAd()
      'bs:disable-next-line
      m.node.analyticsConfig = {}

      'bs:disable-next-line
      result = getSsaiBreakExitEventForDestroy()
    @it("defaults errorSeverity to CRITICAL when not provided")
    function _()
      m.enterFakeSsaiAd()
      'bs:disable-next-line
      sample = onError({ errorCode: 100, errorMessage: "ad load failed" })

      m.assertEqual(sample.errorCode, 100)
      m.assertEqual(sample.errorMessage, "ad load failed")
      m.assertEqual(sample.errorSeverity, "CRITICAL")
    end function

    @it("keeps a provided errorSeverity instead of overwriting it")
    function _()
      m.enterFakeSsaiAd()
      'bs:disable-next-line
      sample = onError({ errorCode: 100, errorMessage: "ad load failed", errorSeverity: "INFO" })

      m.assertEqual(sample.errorSeverity, "INFO")
    end function

    @it("only reports the first error during an ad - subsequent calls return invalid")
    function _()
      m.enterFakeSsaiAd()
      'bs:disable-next-line
      onError({ errorCode: 100, errorMessage: "test error" })
      'bs:disable-next-line
      result = onError({ errorCode: 200, errorMessage: "second error" })

      m.assertInvalid(result)
    end function

    @it("returns AD_ENGAGEMENT event with exitedAdBreak:true when active and tracking enabled")
    function _()
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedPaidAds: 1 })
      'bs:disable-next-line
      adStart({ isSlate: false })
      'bs:disable-next-line
      m.node.analyticsConfig = { ssaiEngagementTrackingEnabled: true }

      'bs:disable-next-line
      result = getSsaiBreakExitEventForDestroy()

      m.assertNotInvalid(result)
      m.assertEqual(result.requestType, 1) ' AD_ENGAGEMENT
      m.assertEqual(result.isSsaiRelated, true)
      m.assertEqual(result.requestData.exitedAdBreak, true)
      m.assertEqual(result.requestData.expectedPaidAds, 1)
    end function

    @it("exit event counters reflect completedPaidAds at time of destroy")
    function _()
      'bs:disable-next-line
      adBreakStart({ adPosition: "preroll", expectedPaidAds: 2 })
      'bs:disable-next-line
      adStart({ isSlate: false })
      'bs:disable-next-line
      adQuartileFinished("completed")
      'bs:disable-next-line
      adStart({ isSlate: false })
      'bs:disable-next-line
      m.node.analyticsConfig = { ssaiEngagementTrackingEnabled: true }

      'bs:disable-next-line
      result = getSsaiBreakExitEventForDestroy()

      m.assertEqual(result.requestData.completedPaidAds, 1)
      m.assertEqual(result.requestData.exitedAdBreak, true)
    end function

    ' UTILITY FUNCTIONS
    function enterFakeSsaiAd()
      'bs:disable-next-line
      adBreakStart()
      'bs:disable-next-line
      adStart()
    end function

  end class

end namespace
