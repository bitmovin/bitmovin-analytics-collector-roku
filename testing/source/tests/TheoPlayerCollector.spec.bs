    @it("returns invalid when sources array is empty")
    function _()
      m.mockPlayer.source = { sources: [] }

      'bs:disable-next-line
      result = getActiveSource(m.mockPlayer)

      m.assertInvalid(result)
    end function

    @it("returns the first source from the sources array")
    function _()
      firstSource = { src: "http://example.com/stream.m3u8", type: "application/x-mpegURL" }
      m.mockPlayer.source = { sources: [firstSource, { src: "http://example.com/backup.m3u8", type: "application/x-mpegURL" }] }

      'bs:disable-next-line
      result = getActiveSource(m.mockPlayer)

      m.assertEqual(result.src, firstSource.src)
      m.assertEqual(result.type, firstSource.type)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("detectSourceFormat")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("does not call updateSample when player has no source")
    function _()
      testContext = { updateSampleCalled: false }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.updateSampleCalled = true
          end if
          return true
        end function,
        testContext: testContext
      }

      m.mockPlayer.source = invalid

      'bs:disable-next-line
      detectSourceFormat()

      m.assertFalse(testContext.updateSampleCalled)
      m.node.collectorCore = originalCollectorCore
    end function

    @it("calls updateSample with mapped source when source is available")
    function _()
      testContext = { capturedSampleData: invalid }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSampleData = sampleData
          end if
          return true
        end function,
        testContext: testContext
      }

      m.mockPlayer.source = {
        sources: [{ src: "http://example.com/stream.m3u8", type: "application/x-mpegURL" }]
      }

      'bs:disable-next-line
      detectSourceFormat()

      m.assertNotInvalid(testContext.capturedSampleData)
      m.assertEqual(testContext.capturedSampleData.streamFormat, "hls")
      m.assertEqual(testContext.capturedSampleData.m3u8Url, "http://example.com/stream.m3u8")
      m.node.collectorCore = originalCollectorCore
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("onSourceChange")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("updates sample with source metadata when source changes")
    function _()
      testContext = { capturedSampleData: invalid }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSampleData = sampleData
          end if
          return true
        end function,
        testContext: testContext
      }

      'bs:disable-next-line
      m.node.currentState = "setup"

      m.mockPlayer.source = {
        sources: [{ src: "http://example.com/stream.mpd", type: "application/dash+xml" }]
      }

      'bs:disable-next-line
      onSourceChange()

      m.assertNotInvalid(testContext.capturedSampleData)
      m.assertEqual(testContext.capturedSampleData.streamFormat, "dash")
      m.assertEqual(testContext.capturedSampleData.mpdUrl, "http://example.com/stream.mpd")
      m.node.collectorCore = originalCollectorCore
    end function

    @it("does not update sample when source is not yet available")
    function _()
      testContext = { updateSampleCalled: false }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.updateSampleCalled = true
          end if
          return true
        end function,
        testContext: testContext
      }

      'bs:disable-next-line
      m.node.currentState = "setup"

      m.mockPlayer.source = invalid

      'bs:disable-next-line
      onSourceChange()

      m.assertFalse(testContext.updateSampleCalled)
      m.node.collectorCore = originalCollectorCore
    end function

    @it("does not call setupSample during initial source load")
    function _()
      testContext = { setupSampleCalled: false }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "setupSample"
            m.testContext.setupSampleCalled = true
          end if
          return true
        end function,
        testContext: testContext
      }

      'bs:disable-next-line
      m.node.currentState = "setup"

      m.mockPlayer.source = {
        sources: [{ src: "http://example.com/stream.m3u8", type: "application/x-mpegURL" }]
      }

      'bs:disable-next-line
      onSourceChange()

      m.assertFalse(testContext.setupSampleCalled)
      m.node.collectorCore = originalCollectorCore
    end function

    @it("calls setupSample before detectSourceFormat when source changes after initial setup")
    function _()
      testContext = { callOrder: [] }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          m.testContext.callOrder.Push(funcName)
          return true
        end function,
        testContext: testContext
      }

      'bs:disable-next-line
      m.node.currentState = "playing"
      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")

      mockVideoNode({ height: 1080, width: 1920 })
      m.mockPlayer.audioTracks = []
      m.mockPlayer.textTracks = []
      m.mockPlayer.duration = 60
      m.mockPlayer.currentTime = 0
      m.mockPlayer.source = {
        sources: [{ src: "http://example.com/new-stream.m3u8", type: "application/x-mpegURL" }]
      }

      'bs:disable-next-line
      onSourceChange()

      setupIndex = -1
      updateIndex = -1
      for i = 0 to testContext.callOrder.Count() - 1
        if testContext.callOrder[i] = "setupSample" then setupIndex = i
        if testContext.callOrder[i] = "updateSample" then updateIndex = i
      end for

      m.assertTrue(setupIndex >= 0, "setupSample should have been called")
      m.assertTrue(updateIndex >= 0, "updateSample should have been called")
      m.assertTrue(setupIndex < updateIndex, "setupSample should be called before updateSample")
      m.node.collectorCore = originalCollectorCore
    end function

    @it("clears video start timeout when source changes")
    function _()
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          return true
        end function
      }

      'bs:disable-next-line
      m.node.currentState = "setup"

      'bs:disable-next-line
      startVideoStartTimeout()
      'bs:disable-next-line
      m.assertEqual(getVideoStartTimeoutTimerControl(), "start")

      m.mockPlayer.source = {
        sources: [{ src: "http://example.com/stream.m3u8", type: "application/x-mpegURL" }]
      }

      'bs:disable-next-line
      onSourceChange()

      'bs:disable-next-line
      m.assertEqual(getVideoStartTimeoutTimerControl(), "stop")
      m.node.collectorCore = originalCollectorCore
    end function

    @it("resets videoStartUpTime when source changes after initial setup")
    function _()
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          return true
        end function
      }

      'bs:disable-next-line
      m.node.currentState = "playing"
      'bs:disable-next-line
      m.node.videoStartUpTime = 500
      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")

      mockVideoNode({ height: 1080, width: 1920 })
      m.mockPlayer.audioTracks = []
      m.mockPlayer.textTracks = []
      m.mockPlayer.duration = 60
      m.mockPlayer.currentTime = 0
      m.mockPlayer.source = {
        sources: [{ src: "http://example.com/new-stream.m3u8", type: "application/x-mpegURL" }]
      }

      'bs:disable-next-line
      onSourceChange()

      'bs:disable-next-line
      m.assertEqual(m.node.videoStartUpTime, -1)
      m.node.collectorCore = originalCollectorCore
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("initializePlayer")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sends a setup sample when initializing the player")
    function _()
      ' Store reference to test context for use in mock
      testContext = { capturedSampleData: invalid }

      ' Save original collectorCore to restore later
      originalCollectorCore = m.node.collectorCore

      ' Create a mock collectorCore that captures the sampleData
      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSampleData = sampleData
          end if
          return true
        end function,
        observeFieldScoped: function(field as string, callback as string)
        end function,
        unobserveFieldScoped: function(field as string)
        end function,
        testContext: testContext
      }

      ' Set up mock player with required fields
      m.mockPlayer.version = "1.0.0"

      m.mockPlayer = {
        callFunc: function(funcName as string, arg1 = invalid, arg2 = invalid, arg3 = invalid)
          if funcName = "getVideoNode" then
            return {
              height: 1080,
              width: 1920,
              observeFieldScoped: function(field as string, callback as string)end function,
              unobserveFieldScoped: function(field as string)end function
            }
          end if
          return invalid
        end function
      }

      m.mockPlayer.version = "1.0.0"
      m.mockPlayer.audioTracks = []
      m.mockPlayer.textTracks = []
      m.mockPlayer.duration = 60
      m.mockPlayer.currentTime = 0
      m.mockPlayer.source = invalid

      'bs:disable-next-line
      initializePlayer(m.mockPlayer)

      ' Verify the sample was sent with state = "setup"
      m.assertNotInvalid(testContext.capturedSampleData)
      m.assertEqual(testContext.capturedSampleData.state, "setup")

      ' Restore original collectorCore
      m.node.collectorCore = originalCollectorCore
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("transitionToState")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sets previousState to currentState and currentState to nextState")
    function _()
      'bs:disable-next-line
      m.node.currentState = "setup"
      'bs:disable-next-line
      m.node.previousState = ""

      'bs:disable-next-line
      transitionToState("playing")

      'bs:disable-next-line
      m.assertEqual(m.node.previousState, "setup")
      'bs:disable-next-line
      m.assertEqual(m.node.currentState, "playing")
    end function

    @it("updates previousState on consecutive transitions")
    function _()
      'bs:disable-next-line
      m.node.currentState = "setup"
      'bs:disable-next-line
      m.node.previousState = ""

      'bs:disable-next-line
      transitionToState("playing")
      'bs:disable-next-line
      transitionToState("playing")

      'bs:disable-next-line
      m.assertEqual(m.node.previousState, "playing")
      'bs:disable-next-line
      m.assertEqual(m.node.currentState, "playing")
    end function

