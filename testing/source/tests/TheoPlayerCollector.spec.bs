    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("programChange")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("does nothing when called with invalid metadata")
    function _()
      testContext = { callCount: 0 }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          m.testContext.callCount++
          return true
        end function,
        testContext: testContext
      }

      'bs:disable-next-line
      programChange(invalid)

      m.assertEqual(testContext.callCount, 0)
      m.node.collectorCore = originalCollectorCore
    end function

    @it("applies metadata update but does not start new impression when called in SETUP state")
    function _()
      testContext = { capturedFuncName: invalid, capturedMetadata: invalid }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          m.testContext.capturedFuncName = funcName
          m.testContext.capturedMetadata = sampleData
          return true
        end function,
        testContext: testContext
      }

      'bs:disable-next-line
      m.node.currentState = "setup"

      'bs:disable-next-line
      programChange({ title: "New Program" })

      m.assertEqual(testContext.capturedFuncName, "updateAnalyticsConfig")
      m.assertEqual(testContext.capturedMetadata.title, "New Program")
      m.node.collectorCore = originalCollectorCore
    end function

    @it("does not conclude or start an impression when called in SETUP state")
    function _()
      testContext = { calledFunctions: {} }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          m.testContext.calledFunctions[funcName] = true
          return true
        end function,
        testContext: testContext
      }

      'bs:disable-next-line
      m.node.currentState = "setup"

      'bs:disable-next-line
      programChange({ title: "New Program" })

      m.assertFalse(testContext.calledFunctions.doesExist("sendAnalyticsRequestAndClearValues"))
      m.assertFalse(testContext.calledFunctions.doesExist("setupSample"))
      m.node.collectorCore = originalCollectorCore
    end function

    @it("concludes current impression and starts new one when playing")
    function _()
      testContext = { capturedSamples: [], capturedConfigMetadata: invalid }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSamples.Push(sampleData)
          else if funcName = "updateAnalyticsConfig"
            m.testContext.capturedConfigMetadata = sampleData
          end if
          return true
        end function,
        testContext: testContext
      }

      m.mockPlayer.currentTime = 30
      mockVideoNode({ height: 1080, width: 1920 })
      m.mockPlayer.audioTracks = []
      m.mockPlayer.textTracks = []
      m.mockPlayer.duration = 60

      newMetadata = { title: "New Program" }
      'bs:disable-next-line
      m.node.currentState = "playing"
      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")

      'bs:disable-next-line
      programChange(newMetadata)

      ' Final impression sample
      m.assertTrue(testContext.capturedSamples.Count() >= 3)
      finalSample = testContext.capturedSamples[0]
      m.assertTrue(finalSample.isProgramChange)
      m.assertNotInvalid(finalSample.played)
      m.assertEqual(finalSample.state, "playing")

      ' updateAnalyticsConfig called with new metadata
      m.assertNotInvalid(testContext.capturedConfigMetadata)
      m.assertEqual(testContext.capturedConfigMetadata.title, "New Program")

      ' programChange sample (last updateSample call)
      programChangeSample = testContext.capturedSamples[testContext.capturedSamples.Count() - 1]
      m.assertTrue(programChangeSample.isProgramChange)
      m.assertEqual(programChangeSample.videoStartupTime, 1)
      m.assertEqual(programChangeSample.state, "programChange")

      m.node.collectorCore = originalCollectorCore
    end function

    @it("concludes current impression when paused")
    function _()
      testContext = { capturedSamples: [] }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
