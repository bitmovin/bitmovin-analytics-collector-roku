namespace tests
  @SGNode("theoPlayerCollector")
  @suite
  class TheoPlayerCollectorTests extends rooibos.BaseTestSuite

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("TheoPlayerCollector")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    protected override function beforeEach()
      'bs:disable-next-line
      initializeAnalytics()

      m.mockPlayer = {
        callFunc: function(funcName as string, arg1 = invalid, arg2 = invalid, arg3 = invalid)
          return invalid
        end function
      }

      m.node.player = m.mockPlayer

      ' Reset videoNode to invalid to prevent unobserveFieldScoped errors
      ' Tests that need videoNode should set up their own mock with the required methods
      'bs:disable-next-line
      m.node.videoNode = invalid
    end function

    protected override function afterEach()
      m.cleanStubs()
      m.cleanMocks()
    end function

    @it("should correctly return the player version")
    function _()
      m.mockPlayer.version = "0.0.0"

      'bs:disable-next-line
      returnedPlayerVersion = getPlayerVersion()

      m.assertEqual(returnedPlayerVersion, "theoplayer-0.0.0")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("setUpVersionDependentObservers")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("uses bitratechange for older THEOplayer versions")
    function _()
      testContext = { listeners: [] }

      m.mockPlayer.version = "10.10.0"
      m.mockPlayer.callFunc = function(funcName as string, arg1 = invalid, arg2 = invalid, arg3 = invalid)
        if funcName = "addEventListener"
          m.testContext.listeners.Push({
            eventName: arg1
            handler: arg3
          })
        end if
        return invalid
      end function
      m.mockPlayer.testContext = testContext

      'bs:disable-next-line
      setUpVersionDependentObservers()

      m.assertEqual(testContext.listeners.Count(), 1)
      m.assertEqual(testContext.listeners[0].eventName, "bitratechange")
      m.assertEqual(testContext.listeners[0].handler, "onBitrateChange")
    end function

    @it("uses activequalitychanged for THEOplayer 10.11 and newer versions")
    @params("11.0.0")
    @params("10.11.0")
    function _(playerVersion as string)
      testContext = { listeners: [] }

      m.mockPlayer.version = playerVersion
      m.mockPlayer.callFunc = function(funcName as string, arg1 = invalid, arg2 = invalid, arg3 = invalid)
        if funcName = "addEventListener"
          m.testContext.listeners.Push({
            eventName: arg1
            handler: arg3
          })
        end if
        return invalid
      end function
      m.mockPlayer.testContext = testContext

      'bs:disable-next-line
      setUpVersionDependentObservers()

      m.assertEqual(testContext.listeners.Count(), 1)
      m.assertEqual(testContext.listeners[0].eventName, "activequalitychanged")
      m.assertEqual(testContext.listeners[0].handler, "onActiveQualityChanged")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getCurrentAudioLanguage")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns invalid when audioTracks is invalid")
   function _()
      'bs:disable-next-line
      result = getCurrentAudioLanguage(invalid)

      m.assertInvalid(result)
    end function

    @it("returns invalid when audioTracks is empty")
    function _()
      audioTracks = []

      'bs:disable-next-line
      result = getCurrentAudioLanguage(audioTracks)

      m.assertInvalid(result)
    end function

    @it("returns the language of the enabled audio track")
    function _()
      audioTracks = [
        { enabled: false, language: "de" },
        { enabled: true, language: "en" },
        { enabled: false, language: "fr" }
      ]

      'bs:disable-next-line
      result = getCurrentAudioLanguage(audioTracks)

      m.assertEqual(result, "en")
    end function

    @it("returns invalid when no audio track is enabled")
    function _()
      audioTracks = [
        { enabled: false, language: "de" },
        { enabled: false, language: "en" }
      ]

      'bs:disable-next-line
      result = getCurrentAudioLanguage(audioTracks)

      m.assertInvalid(result)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
