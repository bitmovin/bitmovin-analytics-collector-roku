      ' First sample should be the played state sample
      m.assertTrue(testContext.capturedSamples.Count() >= 2)
      m.assertEqual(testContext.capturedSamples[0].state, "playing")
      m.assertNotInvalid(testContext.capturedSamples[0].played)

      ' Second sample should be qualityChange with new bitrate
      m.assertEqual(testContext.capturedSamples[1].state, "qualityChange")
      m.assertEqual(testContext.capturedSamples[1].videoBitrate, 5000000)

      m.node.collectorCore = originalCollectorCore
    end function

