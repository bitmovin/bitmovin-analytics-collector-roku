      'bs:disable-next-line
      onSourceChange()

      metadataApplied = false
      for each update in testContext.capturedUpdates
        if update.DoesExist("title") and update.title = "My Video" and update.videoId = "video-123"
          metadataApplied = true
        end if
      end for

      m.assertTrue(metadataApplied, "pending metadata should be applied via updateSample on source change")
      'bs:disable-next-line
      m.assertInvalid(m.node.pendingMetadata)
      m.node.collectorCore = originalCollectorCore
    end function

