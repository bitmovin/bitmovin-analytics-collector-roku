    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("mapSource")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns empty object when source is invalid")
    function _()
      'bs:disable-next-line
      result = mapSource(invalid)

      m.assertEqual(result.Count(), 0)
    end function

    @it("returns empty object when source type is invalid")
    function _()
      source = { src: "http://example.com/stream.m3u8", type: invalid }

      'bs:disable-next-line
      result = mapSource(source)

      m.assertEqual(result.Count(), 0)
    end function

    @it("maps application/x-mpegURL to hls stream format")
    function _()
      source = { src: "http://example.com/stream.m3u8", type: "application/x-mpegURL" }

      'bs:disable-next-line
      result = mapSource(source)

      m.assertEqual(result.streamFormat, "hls")
      m.assertEqual(result.m3u8Url, "http://example.com/stream.m3u8")
    end function

    @it("maps application/dash+xml to dash stream format")
    function _()
      source = { src: "http://example.com/stream.mpd", type: "application/dash+xml" }

      'bs:disable-next-line
      result = mapSource(source)

      m.assertEqual(result.streamFormat, "dash")
      m.assertEqual(result.mpdUrl, "http://example.com/stream.mpd")
    end function

    @it("maps theolive type to hls stream format")
    function _()
      source = { src: "http://example.com/theolive-channel", type: "theolive" }

      'bs:disable-next-line
      result = mapSource(source)

      m.assertEqual(result.streamFormat, "hls")
      m.assertEqual(result.m3u8Url, "http://example.com/theolive-channel")
    end function

    @it("falls back to progressive for unknown type")
    function _()
      source = { src: "http://example.com/video.mp4", type: "video/mp4" }

      'bs:disable-next-line
      result = mapSource(source)

      m.assertEqual(result.streamFormat, "progressive")
      m.assertEqual(result.progUrl, "http://example.com/video.mp4")
    end function

