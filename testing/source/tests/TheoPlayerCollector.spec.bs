      }

      m.mockPlayer.currentTime = 30
      m.mockPlayer.callFunc = function(funcName as string, arg1 = invalid, arg2 = invalid, arg3 = invalid)
        if funcName = "getVideoNode"
          return { height: 1080, width: 1920 }
        end if
        return invalid
      end function
      m.mockPlayer.audioTracks = []
      m.mockPlayer.textTracks = []
      m.mockPlayer.duration = 60

      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.previousState = ""
      'bs:disable-next-line
      m.node.currentState = "playing"

      'bs:disable-next-line
      onAdBegin()

      closingPlayingSample = invalid
      for each sampleData in testContext.capturedSamples
        if sampleData.DoesExist("state") and sampleData.state = "playing"
          closingPlayingSample = sampleData
        end if
      end for

      m.assertNotInvalid(closingPlayingSample)
      m.assertNotInvalid(closingPlayingSample.played)

      m.node.collectorCore = originalCollectorCore
    end function

    @it("onPlaying after ad closes the ad state and transitions to playing")
    function _()
      testContext = { capturedSamples: [] }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSamples.Push(sampleData)
          end if
          return true
        end function,
        playerState: "",
        testContext: testContext
      }

      m.mockPlayer.currentTime = 30
      m.mockPlayer.callFunc = function(funcName as string, arg1 = invalid, arg2 = invalid, arg3 = invalid)
        if funcName = "getVideoNode"
          return { height: 1080, width: 1920 }
        end if
        return invalid
      end function
      m.mockPlayer.audioTracks = []
      m.mockPlayer.textTracks = []
      m.mockPlayer.duration = 60

      'bs:disable-next-line
      m.node.videoStartupTimer = invalid
      'bs:disable-next-line
      m.node.videoStartUpTime = 1
      'bs:disable-next-line
      m.node.didVideoPlay = true
      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.previousState = "playing"
      'bs:disable-next-line
      m.node.currentState = "ad"

      'bs:disable-next-line
      onPlaying()

      closingAdSample = invalid
      for each sampleData in testContext.capturedSamples
        if sampleData.DoesExist("state") and sampleData.state = "ad"
          closingAdSample = sampleData
        end if
      end for

      m.assertNotInvalid(closingAdSample)
      m.assertNotInvalid(closingAdSample.played)
      'bs:disable-next-line
      m.assertEqual(m.node.currentState, "playing")

      m.node.collectorCore = originalCollectorCore
    end function

  end class

end namespace

function getVideoStartTimeoutTimerControl() as string
  return m.videoStartTimeoutTimer.control
end function

function mockVideoNode(node) as object
  m.videoNode = node
end function

function modifyTheoErrorData(errorEvent)
  errorData = errorEvent.getData()

  errorData.error.message = errorData.error.message + "-MODIFIED"
  errorData.error.code = errorData.error.code + 1
  errorData.error.severity = "INFO"

  m.top.error = errorData
end function
