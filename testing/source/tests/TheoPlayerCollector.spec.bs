namespace tests
  @SGNode("theoPlayerCollector")
  @suite
  class TheoPlayerCollectorTests extends rooibos.BaseTestSuite

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("TheoPlayerCollector")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    protected override function beforeEach()
      'bs:disable-next-line
      initializeAnalytics()

      m.mockPlayer = { }

      m.node.player = m.mockPlayer
    end function

    protected override function afterEach()
      m.cleanStubs()
      m.cleanMocks()
    end function

    @it("should correctly return the player version")
    function _()
      m.mockPlayer.version = "0.0.0"

      'bs:disable-next-line
      returnedPlayerVersion = getPlayerVersion()

      m.assertEqual(returnedPlayerVersion, "theo-0.0.0")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getCurrentAudioLanguage")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns invalid when audioTracks is invalid")
    function _()
      'bs:disable-next-line
      result = getCurrentAudioLanguage(invalid)

      m.assertInvalid(result)
    end function

    @it("returns invalid when audioTracks is empty")
    function _()
      audioTracks = []

      'bs:disable-next-line
      result = getCurrentAudioLanguage(audioTracks)

      m.assertInvalid(result)
    end function

    @it("returns the language of the enabled audio track")
    function _()
      audioTracks = [
        { enabled: false, language: "de" },
        { enabled: true, language: "en" },
        { enabled: false, language: "fr" }
      ]

      'bs:disable-next-line
      result = getCurrentAudioLanguage(audioTracks)

      m.assertEqual(result, "en")
    end function

    @it("returns invalid when no audio track is enabled")
    function _()
      audioTracks = [
        { enabled: false, language: "de" },
        { enabled: false, language: "en" }
      ]

      'bs:disable-next-line
      result = getCurrentAudioLanguage(audioTracks)

      m.assertInvalid(result)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getCurrentSubtitleLanguage")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns invalid when textTracks is invalid")
    function _()
      'bs:disable-next-line
      result = getCurrentSubtitleLanguage(invalid)

      m.assertInvalid(result)
    end function

    @it("returns invalid when textTracks is empty")
    function _()
      textTracks = []

      'bs:disable-next-line
      result = getCurrentSubtitleLanguage(textTracks)

      m.assertInvalid(result)
    end function

    @it("returns the language of the text track with mode 'showing'")
    function _()
      textTracks = [
        { mode: "disabled", language: "de" },
        { mode: "showing", language: "en" },
        { mode: "hidden", language: "fr" }
      ]

      'bs:disable-next-line
      result = getCurrentSubtitleLanguage(textTracks)

      m.assertEqual(result, "en")
    end function

    @it("returns invalid when no text track has mode 'showing'")
    function _()
      textTracks = [
        { mode: "disabled", language: "de" },
        { mode: "hidden", language: "en" }
      ]

      'bs:disable-next-line
      result = getCurrentSubtitleLanguage(textTracks)

      m.assertInvalid(result)
    end function

    @it("returns the first 'showing' track language when multiple are showing")
    function _()
      textTracks = [
        { mode: "showing", language: "de" },
        { mode: "showing", language: "en" }
      ]

      'bs:disable-next-line
      result = getCurrentSubtitleLanguage(textTracks)

      m.assertEqual(result, "de")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getVideoDuration")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns invalid when player duration is invalid")
    function _()
      m.mockPlayer.duration = invalid

      'bs:disable-next-line
      result = getVideoDuration()

      m.assertInvalid(result)
    end function

    @it("converts duration from seconds to milliseconds")
    function _()
      m.mockPlayer.duration = 1

      'bs:disable-next-line
      result = getVideoDuration()

      m.assertEqual(result, 1000)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("decorateSampleWithPlaybackData")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns early when sampleData is invalid")
    function _()
      ' Should not crash when called with invalid
      'bs:disable-next-line
      decorateSampleWithPlaybackData(invalid)

      m.assertTrue(true)
    end function

    @it("decorates sample with playback data")
    function _()
      m.mockPlayer.callFunc = function(funcName as string)
        if funcName = "getVideoNode"
          return { height: 1080, width: 1920 }
        end if
        return invalid
      end function
      m.mockPlayer.audioTracks = [{ enabled: true, language: "en" }]
      m.mockPlayer.textTracks = [{ mode: "showing", language: "de" }]
      m.mockPlayer.duration = 120

      sampleData = {}

      'bs:disable-next-line
      decorateSampleWithPlaybackData(sampleData)

      m.assertEqual(sampleData.audioLanguage, "en")
      m.assertEqual(sampleData.subtitleLanguage, "de")
      m.assertEqual(sampleData.videoDuration, 120000)
      m.assertNotInvalid(sampleData.subtitleEnabled)
      m.assertNotInvalid(sampleData.videoWindowHeight)
      m.assertNotInvalid(sampleData.videoWindowWidth)
      m.assertNotInvalid(sampleData.size)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("getPlayerKeyFromManifest")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("returns invalid when appInfo is invalid")
    function _()
      'bs:disable-next-line
      result = getPlayerKeyFromManifest(invalid)

      m.assertInvalid(result)
    end function

    @it("returns the player key from manifest")
    function _()
      mockAppInfo = {
        getValue: function(key as string)
          if key = "theo_player_license_key"
            return "test-license-key-123"
          end if
          return invalid
        end function
      }

      'bs:disable-next-line
      result = getPlayerKeyFromManifest(mockAppInfo)

      m.assertEqual(result, "test-license-key-123")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("initializePlayer")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sends a setup sample when initializing the player")
    function _()
      ' Store reference to test context for use in mock
      testContext = { capturedSampleData: invalid }

      ' Save original collectorCore to restore later
      originalCollectorCore = m.node.collectorCore

      ' Create a mock collectorCore that captures the sampleData
      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSampleData = sampleData
          end if
          return true
        end function,
        observeFieldScoped: function(field as string, callback as string)
        end function,
        unobserveFieldScoped: function(field as string)
        end function,
        testContext: testContext
      }

      ' Set up mock player with required fields
      m.mockPlayer.version = "1.0.0"
      m.mockPlayer.callFunc = function(funcName as string, arg1 = invalid, arg2 = invalid, arg3 = invalid)
        if funcName = "getVideoNode"
          return { height: 1080, width: 1920 }
        end if
        return invalid
      end function
      m.mockPlayer.audioTracks = []
      m.mockPlayer.textTracks = []
      m.mockPlayer.duration = 60
      m.mockPlayer.currentTime = 0
      m.mockPlayer.observeFieldScoped = function(field as string, callback as string)
      end function

      'bs:disable-next-line
      initializePlayer(m.mockPlayer)

      ' Verify the sample was sent with state = "setup"
      m.assertNotInvalid(testContext.capturedSampleData)
      m.assertEqual(testContext.capturedSampleData.state, "setup")

      ' Restore original collectorCore
      m.node.collectorCore = originalCollectorCore
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("transitionToState")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("sets previousState to currentState and currentState to nextState")
    function _()
      'bs:disable-next-line
      m.node.currentState = "setup"
      'bs:disable-next-line
      m.node.previousState = ""

      'bs:disable-next-line
      transitionToState("playing")

      'bs:disable-next-line
      m.assertEqual(m.node.previousState, "setup")
      'bs:disable-next-line
      m.assertEqual(m.node.currentState, "playing")
    end function

    @it("updates previousState on consecutive transitions")
    function _()
      'bs:disable-next-line
      m.node.currentState = "setup"
      'bs:disable-next-line
      m.node.previousState = ""

      'bs:disable-next-line
      transitionToState("playing")
      'bs:disable-next-line
      transitionToState("playing")

      'bs:disable-next-line
      m.assertEqual(m.node.previousState, "playing")
      'bs:disable-next-line
      m.assertEqual(m.node.currentState, "playing")
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("onPlay")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("initializes the video startup timer")
    function _()
      'bs:disable-next-line
      m.node.videoStartupTimer = invalid

      'bs:disable-next-line
      onPlay()

      'bs:disable-next-line
      m.assertNotInvalid(m.node.videoStartupTimer)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("startVideoStartUpTimer")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("creates a roTimeSpan timer")
    function _()
      'bs:disable-next-line
      m.node.videoStartupTimer = invalid

      'bs:disable-next-line
      startVideoStartUpTimer()

      'bs:disable-next-line
      m.assertNotInvalid(m.node.videoStartupTimer)
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("stopVideoStartUpTimer")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("does nothing when timer is invalid")
    function _()
      testContext = { sendCount: 0 }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "sendAnalyticsRequestAndClearValues"
            m.testContext.sendCount++
          end if
          return true
        end function,
        testContext: testContext
      }

      'bs:disable-next-line
      m.node.videoStartupTimer = invalid
      'bs:disable-next-line
      m.node.videoStartUpTime = -1

      'bs:disable-next-line
      stopVideoStartUpTimer()

      m.assertEqual(testContext.sendCount, 0)
      m.node.collectorCore = originalCollectorCore
    end function

    @it("does nothing when startup time was already measured")
    function _()
      testContext = { sendCount: 0 }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.sendCount++
          end if
          return true
        end function,
        testContext: testContext
      }

      'bs:disable-next-line
      m.node.videoStartupTimer = CreateObject("roTimeSpan")
      'bs:disable-next-line
      m.node.videoStartUpTime = 500

      'bs:disable-next-line
      stopVideoStartUpTimer()

      m.assertEqual(testContext.sendCount, 0)
      m.node.collectorCore = originalCollectorCore
    end function

    @it("sends startup sample and stores time when timer is active")
    function _()
      testContext = { capturedSampleData: invalid }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSampleData = sampleData
          end if
          return true
        end function,
        testContext: testContext
      }

      m.mockPlayer.currentTime = 0
      m.mockPlayer.callFunc = function(funcName as string, arg1 = invalid, arg2 = invalid, arg3 = invalid)
        if funcName = "getVideoNode"
          return { height: 1080, width: 1920 }
        end if
        return invalid
      end function
      m.mockPlayer.audioTracks = []
      m.mockPlayer.textTracks = []
      m.mockPlayer.duration = 60

      'bs:disable-next-line
      m.node.videoStartupTimer = CreateObject("roTimeSpan")
      'bs:disable-next-line
      m.node.videoStartUpTime = -1

      'bs:disable-next-line
      stopVideoStartUpTimer()

      m.assertNotInvalid(testContext.capturedSampleData)
      m.assertEqual(testContext.capturedSampleData.state, "startup")
      m.assertNotInvalid(testContext.capturedSampleData.videoStartupTime)
      m.assertNotInvalid(testContext.capturedSampleData.startupTime)
      m.assertEqual(testContext.capturedSampleData.videoTimeStart, 0)
      m.assertEqual(testContext.capturedSampleData.videoTimeEnd, 0)

      'bs:disable-next-line
      m.assertTrue(m.node.videoStartUpTime >= 0)

      m.node.collectorCore = originalCollectorCore
    end function

    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
    @describe("onPlaying")
    '+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

    @it("transitions to playing state and propagates to collectorCore")
    function _()
      testContext = { capturedSampleData: invalid }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSampleData = sampleData
          end if
          return true
        end function,
        playerState: "",
        testContext: testContext
      }

      m.mockPlayer.currentTime = 10
      m.mockPlayer.callFunc = function(funcName as string, arg1 = invalid, arg2 = invalid, arg3 = invalid)
        if funcName = "getVideoNode"
          return { height: 1080, width: 1920 }
        end if
        return invalid
      end function
      m.mockPlayer.audioTracks = []
      m.mockPlayer.textTracks = []
      m.mockPlayer.duration = 60

      'bs:disable-next-line
      m.node.videoStartupTimer = invalid
      'bs:disable-next-line
      m.node.videoStartUpTime = -1
      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.previousState = ""
      'bs:disable-next-line
      m.node.currentState = "setup"

      'bs:disable-next-line
      onPlaying()

      'bs:disable-next-line
      m.assertEqual(m.node.currentState, "playing")
      m.assertEqual(m.node.collectorCore.playerState, "playing")

      m.node.collectorCore = originalCollectorCore
    end function

    @it("sends startup sample on first playing event after play")
    function _()
      testContext = { capturedSamples: [] }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSamples.Push(sampleData)
          end if
          return true
        end function,
        playerState: "",
        testContext: testContext
      }

      m.mockPlayer.currentTime = 0
      m.mockPlayer.callFunc = function(funcName as string, arg1 = invalid, arg2 = invalid, arg3 = invalid)
        if funcName = "getVideoNode"
          return { height: 1080, width: 1920 }
        end if
        return invalid
      end function
      m.mockPlayer.audioTracks = []
      m.mockPlayer.textTracks = []
      m.mockPlayer.duration = 60

      'bs:disable-next-line
      m.node.videoStartupTimer = CreateObject("roTimeSpan")
      'bs:disable-next-line
      m.node.videoStartUpTime = -1
      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.previousState = ""
      'bs:disable-next-line
      m.node.currentState = "setup"

      'bs:disable-next-line
      onPlaying()

      m.assertEqual(testContext.capturedSamples.Count(), 1)
      m.assertEqual(testContext.capturedSamples[0].state, "startup")

      m.node.collectorCore = originalCollectorCore
    end function

    @it("does not send duplicate startup sample on subsequent playing events")
    function _()
      testContext = { capturedSamples: [] }
      originalCollectorCore = m.node.collectorCore

      m.node.collectorCore = {
        callFunc: function(funcName as string, sampleData = invalid)
          if funcName = "updateSample"
            m.testContext.capturedSamples.Push(sampleData)
          end if
          return true
        end function,
        playerState: "",
        testContext: testContext
      }

      m.mockPlayer.currentTime = 0
      m.mockPlayer.callFunc = function(funcName as string, arg1 = invalid, arg2 = invalid, arg3 = invalid)
        if funcName = "getVideoNode"
          return { height: 1080, width: 1920 }
        end if
        return invalid
      end function
      m.mockPlayer.audioTracks = []
      m.mockPlayer.textTracks = []
      m.mockPlayer.duration = 60

      'bs:disable-next-line
      m.node.videoStartupTimer = CreateObject("roTimeSpan")
      'bs:disable-next-line
      m.node.videoStartUpTime = -1
      'bs:disable-next-line
      m.node.playerStateTimer = CreateObject("roTimespan")
      'bs:disable-next-line
      m.node.previousState = ""
      'bs:disable-next-line
      m.node.currentState = "setup"

      'bs:disable-next-line
      onPlaying()
      'bs:disable-next-line
      onPlaying()

      startupSamples = []
      for each sample in testContext.capturedSamples
        if sample.state = "startup" then startupSamples.Push(sample)
      end for

      m.assertEqual(startupSamples.Count(), 1)

      m.node.collectorCore = originalCollectorCore
    end function

  end class

end namespace
