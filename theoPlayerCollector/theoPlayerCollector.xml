<?xml version="1.0" encoding="utf-8"?>
<component name="theoPlayerCollector" extends="baseCollector">
    <script type="text/brightscript" uri="./theoPlayerEnums.brs"/>
    <script type="text/brightscript" uri="./theoPlayerCollector.brs"/>
  <children>
    <Timer id="videoStartTimeoutTimer" repeat="false" duration="60" />
    <collectorCore id="collectorCore"/>
  </children>
  <interface>
    <field id="error" type="assocarray" alwaysnotify="true"/>
    <function name="onPlay" />
    <function name="onPlaying" />
    <function name="onPause" />
    <function name="onBitrateChange" />
    <function name="onActiveQualityChanged" />
    <function name="onDestroy" />
    <function name="onSourceChange" />
    <function name="onSeeking" />
    <function name="onTimeUpdate" />
    <function name="onError" />
    <function name="onAdBreakBegin" />
    <function name="onAdBegin" />
    <function name="onAdEnd" />
    <function name="onAdBreakEnd" />
    <function name="onAdFirstQuartile" />
    <function name="onAdMidpoint" />
    <function name="onAdThirdQuartile" />
    <function name="onAdError" />
    <function name="onCanPlay" />
  </interface>
</component>
